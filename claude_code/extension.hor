// Claude Code as an agent system of Hex's. It tells the agent harness who it is (what Claude Code calls itself as it
// connects, how long its answers can be and what it's told to do first) and how to run it from the Agents panel, claude
// -p with its stream of JSON read into the panel's rows, Hex's own tools handed to it as an MCP server. And it has the
// two commands that set Claude Code up for a folder, the hex server in the folder's .mcp.json and a few lines in its
// CLAUDE.md about the tools.
let extension = {
    name: "Claude Code",
    description: "Claude Code connected to Hex, finding code through Hex's index instead of grep and whole files.",
    version: "1.12.1",
    author: "bogz",
    settings: {
        budget: { title: "Answer size", about: "The most characters a harness answer is for Claude Code when it doesn't say, about four to a token.", kind: "number", least: 1000, most: 60000, step: 1000, default: 8000 },
        server: { title: "Server name", about: "What the server is called in .mcp.json, its tools are mcp__ this __ to Claude Code.", kind: "text", default: "hex" },
        program: { title: "Program", about: "The claude Hex runs from the Agents panel, a name on PATH or a whole path.", kind: "text", default: "claude" },
        model: { title: "Model", about: "The model it asks for, sonnet, opus or a whole name (claude-fable-5-2 for Fable), its own default when empty.", kind: "text", default: "" },
        permission_mode: { title: "Permissions", about: "What it may do without asking, since nobody's there to be asked in the panel.", kind: "choice",
            choices: ["acceptEdits", "default", "plan", "bypassPermissions"], labels: ["Edits accepted", "Ask (refused)", "Plan only", "Anything"],
            help: ["Changes files, runs only what's allowed.", "Anything that would ask is refused.", "Reads and plans, changes nothing.", "Runs anything at all, careful."], default: "acceptEdits" },
        effort: { title: "Effort", about: "How hard it thinks, its own default when empty.", kind: "choice",
            choices: ["", "low", "medium", "high", "xhigh", "max"], labels: ["Default", "Low", "Medium", "High", "Extra high", "Max"], default: "" },
        fallback_model: { title: "Fallback model", about: "The model it falls back on while the one asked for is overloaded, a comma between several, none when empty.", kind: "text", default: "" },
        max_budget: { title: "Budget a turn", about: "The most dollars a turn may spend before it stops, no limit at 0.", kind: "number", least: 0, most: 1000, step: 1, default: 0 },
        harness_guard: { title: "Use Hex's tools in the workspace", about: "Hex's own tools find, read and change the workspace's files faster and in fewer tokens. This says what happens when Claude Code uses its own instead: grep, find or cat in the shell, or its Grep, Glob, Read, Edit and Write.", kind: "choice",
            choices: ["strict", "insist", "remind", "off"], labels: ["Always use Hex's tools", "Search and read with Hex's tools", "Suggest Hex's tools", "Don't interfere"],
            help: ["Searching, reading and editing workspace files any other way is blocked, and Claude Code is told which Hex tool to use instead (hex_search, hex_read, hex_edit, hex_write).", "Searches and shell reads are blocked and pointed to the Hex tool. Its own Read, Edit and Write still work.", "Nothing is blocked. Claude Code is told which Hex tool would have done it.", "Claude Code uses whatever tools it likes."], default: "strict" },
        servers: { title: "Servers for each agent", about: "What Claude Code starts beside every agent Hex runs. Plugins' language servers and MCP servers load the whole solution once per agent, a gigabyte and half a minute of CPU each, where Hex already has the code indexed and its own language servers running.", kind: "choice",
            choices: ["shared", "own"], labels: ["Share Hex's", "Each agent its own"],
            help: ["Your own MCP servers start as they always have, plugins' C# and Python language servers and their MCP servers don't, Hex's tools answer what they would.", "Everything Claude Code would start by itself, for every agent."], default: "shared" },
        allowed_tools: { title: "Allowed tools", about: "Tools it may use without asking, a space between them. Hex's are mcp__hex.", kind: "text", default: "mcp__hex Read Grep Glob" }
    }
};

// What Claude Code is told as it connects, after what Hex tells every agent
let instructions = "Find code through Hex before grep or reading whole files. hex_map once to see the workspace, hex_symbols for where something is declared, hex_search for text (ranked, grouped by file), hex_refs for where a name is used, hex_skim for what files are, hex_read with a symbol to read one method or class instead of the file. Every answer is path:line and ends with the index generation, hex_changes says what moved since. hex_terminal_run runs a command and waits for it, the hex_notebook tools take a notebook's path.";

// What the Agents panel offers over its box for Claude Code, each kept in the setting of its id
let options = [
    { id: "model", title: "Model", icon: "sparkle", choices: [
        { value: "", label: "Default model" }, { value: "opus", label: "Opus" }, { value: "sonnet", label: "Sonnet" }, { value: "haiku", label: "Haiku" },
        { value: "claude-fable-5-2", label: "Fable" }] },
    { id: "effort", title: "Effort", icon: "lightbulb", choices: [
        { value: "", label: "Default effort" }, { value: "low", label: "Low" }, { value: "medium", label: "Medium" }, { value: "high", label: "High" },
        { value: "xhigh", label: "Extra high" }, { value: "max", label: "Max" }] },
    { id: "permission_mode", title: "Permissions", icon: "shield", choices: [
        { value: "acceptEdits", label: "Edits allowed" }, { value: "default", label: "Ask first" }, { value: "plan", label: "Plan only" }, { value: "bypassPermissions", label: "Anything" }] }
];

// The block it writes into CLAUDE.md, between markers so it's found and put right again rather than written twice
let teach_start = "<!-- hex tools -->";
let teach_end = "<!-- /hex tools -->";
let teaching = "## Finding code\n\nThis folder is open in Hex, connected as an MCP server. Find code with its tools before grep or reading whole files, they answer in a fraction of the tokens.\n\n- `hex_map` the folders and what's in them, `hex_files` a file by part of its name\n- `hex_symbols` where something is declared, `hex_refs` where a name is used\n- `hex_search` text or a regex, ranked and grouped by file\n- `hex_skim` what files are without reading them, `hex_read` with a symbol for one method or class\n- `hex_terminal_run` runs a command and waits for it, `hex_changes` says what changed since an answer\n";

// The hex object kept for the run's callbacks, which are only handed the chat and the line
let hex_of = { hex: null };

let ignored_caches = {};

func read_cache(hex, path) {
    if (hex.try_read == null || !hex.exists(path)) return null;
    let read = hex.try_read(path);
    let cached = read.text == null ? null : hex.json_parse(read.text);
    if (typeof(cached) == "object") return cached;
    if (ignored_caches[path] != true) {
        ignored_caches[path] = true;
        print("Could not read the optional cache " + path + ".");
    }
    return null;
}

func on_start(hex) {
    hex_of.hex = hex;
    if (hex.agent == null) {
        hex.say("needs a Hex with the agent harness (hex.agent)");
        return;
    }
    // The models it said the last time, so the picker has them from the start rather than once a run has asked
    let kept = read_cache(hex, models_file(hex))?.models;
    if (typeof(kept) == "list" && len(kept) > 0) discovered.models = kept;
    say_who(hex);
    ask_commands(hex);
    hex.command("Connect Claude Code to this folder", hex => connect(hex));
    hex.command("Teach Claude Code the Hex tools", hex => teach(hex));
}

func on_setting(hex, name, value) {
    if (name == "program") clear_and_discover(hex);
    else say_who(hex);
}

func on_workspace_changed(hex) { clear_and_discover(hex); }

func clear_and_discover(hex) {
    discovered.commands = [];
    discovered.said = "";
    say_who(hex);
    ask_commands(hex);
}

// Initialize the CLI without a user message so the first composer already has the project's skills.
let discovery = { generation: 0 };
func ask_commands(hex) {
    if (hex.program_output == null) return;
    discovery.generation = discovery.generation + 1;
    let generation = discovery.generation;
    // No folder open (a Hex started on nothing) asks from nowhere in particular rather than failing to start
    let folders = hex.workspace == null ? [] : (hex.workspace() ?? []);
    let folder = len(folders) > 0 ? folders[0] : "";
    let request = "{\"type\":\"control_request\",\"request_id\":\"hex-catalog\",\"request\":{\"subtype\":\"initialize\"}}";
    hex.program_output(hex.setting("program"), ["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose"], (hex, output) => {
        if (output == null || generation != discovery.generation) return;
        for (line in output.split("\n")) {
            if (!line.trim().starts_with("{")) continue;
            let response = hex.json_parse(line)?.response;
            if (response?.request_id == "hex-catalog" && response.subtype == "success") {
                introduced(null, response.response ?? {});
                return;
            }
        }
    }, folder, request);
}

// Tells the harness who Claude Code is and how to run it, again whenever its settings change
func say_who(hex) {
    hex.agent({
        id: "claude_code",
        name: "Claude Code",
        // Claude's coral, a shade deeper on a light theme, for its badge in the chats and the systems panel
        colour: "#D97757",
        colour_light: "#C15F3C",
        clients: ["claude-code"],
        budget: hex.setting("budget"),
        instructions: instructions,
        run: {
            program: hex.setting("program"),
            icon: "sparkle",
            install: "Install it with npm install -g @anthropic-ai/claude-code, or say where it is in Claude Code's settings.",
            stdin: true,
            options: options_now(),
            arguments: (prompt, chat) => arguments_for(hex, chat),
            message: (text, chat) => message_of(text, chat),
            // Stop asks it to end its turn, its session left whole to go on from, rather than it being killed
            stop: chat => interrupt_of(chat),
            // The message that has it sum up its context to make room, its own slash command
            compact: "/compact",
            // Its slash commands, its own and the skills it found, as it said them in the handshake, for "/" in the box
            commands: discovered.commands,
            on_event: (chat, event) => heard(chat, event)
        }
    });
}

// What claude is run with for a turn, the prompt going in on its stdin as a line of stream-json, which stays open so
// what's asked while it works goes in too. It says back every message it takes in, so the panel knows it was. The hex
// server in a config file of the chat's own, so nothing of the folder's .mcp.json is needed and chats running at once
// don't write over each other's (the server told which chat it is, for the agents it starts), and the session it was in
// so the chat goes on. What the chat was started with (an agent starting another with a model) over the settings. A tool
// its permission mode would ask about comes back on its stdout as a control request, asked of the person in the chat,
// rather than refused because nobody is at its own prompt
func arguments_for(hex, chat) {
    introduce[chat.id] = true;
    let config = hex.temp + "/claude-mcp-" + chat.id + ".json";
    hex.json_set(config, ["mcpServers", "hex"], hex.mcp_server(chat));
    let arguments = ["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--replay-user-messages", "--verbose", "--mcp-config", config, "--permission-mode", option(hex, chat, "permission_mode"), "--permission-prompt-tool", "stdio"];
    // Shared, the config says every server it gets and it starts no other: the user's own as Claude Code would have
    // started them, and not the plugins' (the dotnet kit's Roslyn navigator loading the whole solution for every agent).
    // Their skills and agents stay, those aren't servers. The plugins that are only language servers are switched off
    // in the chat's settings below, Hex runs those once for everybody
    let shared = (hex.setting("servers") ?? "shared") == "shared" && hex.claude_servers != null;
    if (shared) {
        let folders = hex.workspace();
        let own = hex.claude_servers(len(folders) > 0 ? folders[0] : "");
        for (name in keys(own)) hex.json_set(config, ["mcpServers", name], own[name]);
        // The dotnet kit's Roslyn navigator, which --strict-mcp-config would otherwise leave out, one process for the
        // worktree's agents in Hex rather than a gigabyte for each (null when it isn't on the PATH)
        if (hex.claude_plugin != null && hex.claude_plugin("dotnet-claude-kit")) {
            let roslyn = hex.shared_server(chat, "roslyn", "cwm-roslyn-navigator", []);
            if (roslyn != null) hex.json_set(config, ["mcpServers", "cwm-roslyn-navigator"], roslyn);
        }
        arguments.push("--strict-mcp-config");
    }
    // Written whole every run, the chat's file kept from a run with the other setting says nothing of it
    let settings = hex.temp + "/claude-settings-" + chat.id + ".json";
    hex.json_set(settings, ["enabledPlugins"], shared ? { "csharp-lsp@claude-plugins-official": false, "pyright-lsp@claude-plugins-official": false } : {});
    let settled = shared;
    // The harness said in the system prompt, where it weighs more than the server's instructions, so finding and
    // reading code goes through Hex first. The shell is still there for what the harness doesn't do
    if (hex.harness_rules != null) {
        arguments.push("--append-system-prompt");
        // The Plan tab's rules for this chat's own agent alone, its subagents below are told the harness only
        arguments.push(hex.plan_rules != null ? hex.harness_rules + "\n" + hex.plan_rules : hex.harness_rules);
        // Its own subagents are told nothing of what it was, so the Explore one it sends searching is made again here
        // knowing the harness, in a file of the chat's own as the server is
        let agents = hex.temp + "/claude-agents-" + chat.id + ".json";
        hex.json_set(agents, ["Explore"], {
            description: "Fast read-only agent for exploring the codebase, finding files, searching code and answering questions about it. Say how thorough to be, quick, medium or very thorough.",
            prompt: "You explore a codebase and report back what you found, with path:line for everything, without changing anything. " + hex.harness_rules,
            model: "haiku"
        });
        arguments.push("--agents");
        arguments.push(agents);
    }
    // Told in its system prompt, it still drifts back to grep and cat as a long session leaves the prompt behind, so
    // Hex itself is the hook it runs before its shell, Grep and Glob, which turns a read of the workspace back to the
    // harness, and strict (the default) before its own Read, Edit and Write too, which hex_read, hex_edit and hex_write
    // do in their place. In a settings file of the chat's own, the user's own settings kept as they are
    let guard = hex.setting("harness_guard") ?? "strict";
    if ((guard != "off" || chat.private_worktree) && hex.harness_rules != null && hex.executable != null) {
        let hook = "\"" + hex.executable.replace("\\", "/") + "\" --harness-hook --guard " + guard;
        for (folder in hex.workspace()) hook = hook + " --folder \"" + folder.replace("\\", "/") + "\"";
        if (chat.private_worktree)
            hook = hook + " --agent-chat " + chat.id + " --private-root \"" + chat.folder.replace("\\", "/") + "\"";
        hex.json_set(settings, ["hooks"], { PreToolUse: [{ matcher: "Bash|Grep|Glob|PowerShell|Read|Edit|MultiEdit|Write|NotebookEdit", hooks: [{ type: "command", command: hook, timeout: chat.private_worktree ? 60 : 10 }] }] });
        settled = true;
    }
    if (settled) {
        arguments.push("--settings");
        arguments.push(settings);
    }
    // The setting's tools and the rules the agent that started this one gave it, a line each (hex_agent_spawn's
    // permissions), each rule its own argument so one with a space in it (Bash(git status:*)) stays whole
    let tools = hex.setting("allowed_tools").trim();
    let allowed = rules_of(chat, "allow");
    if (len(tools) > 0 || len(allowed) > 0) {
        arguments.push("--allowedTools");
        if (len(tools) > 0) arguments.push(tools);
        for (rule in allowed) arguments.push(rule);
    }
    let denied = rules_of(chat, "deny");
    if (len(denied) > 0) {
        arguments.push("--disallowedTools");
        for (rule in denied) arguments.push(rule);
    }
    let model = option(hex, chat, "model").trim();
    if (len(model) > 0) {
        arguments.push("--model");
        arguments.push(model);
    }
    let effort = option(hex, chat, "effort") ?? "";
    if (len(effort) > 0) {
        arguments.push("--effort");
        arguments.push(effort);
    }
    let fallback = (hex.setting("fallback_model") ?? "").trim();
    if (len(fallback) > 0) {
        arguments.push("--fallback-model");
        arguments.push(fallback);
    }
    // A setting kept as text by an older Hex reads as a number either way
    let budget = number(hex.setting("max_budget") ?? 0) ?? 0;
    if (typeof(budget) == "number" && budget > 0) {
        arguments.push("--max-budget-usd");
        arguments.push("" + budget);
    }
    let session = chat.session();
    if (session != null) {
        arguments.push("--resume");
        arguments.push(session);
    }
    return arguments;
}

// An option of the chat's when it was started with one, the setting otherwise
func option(hex, chat, id) {
    return chat.option(id) ?? hex.setting(id);
}

// The rules of a kind (allow or deny) the agent that started this one gave it, a line each in the chat's option
func rules_of(chat, kind) {
    return (chat.option(kind) ?? "").split("\n").map(rule => rule.trim()).filter(rule => len(rule) > 0);
}

// What takes back each question still waiting for the person, by the request it answers
let leave_asked = {};

// A tool asked leave for, answered on claude's stdin as control_response
func asked_leave(chat, id, request) {
    let tool = request.tool_name ?? "tool";
    let input = request.input ?? {};
    if ((tool == "Bash" || tool == "PowerShell") && hex_of.hex?.harness_check != null) {
        let instead = hex_of.hex.harness_check(input.command ?? "");
        if (instead != null) {
            if (chat.note != null) chat.note("$(shield) Turned back to Hex's tools: " + (input.command ?? "") + ", " + instead);
            leave_given(chat, id, input, false, "This reads the workspace the long way, use " + instead + ".");
            return;
        }
    }
    if (tool == "AskUserQuestion" && chat.question != null) {
        asked_questions(chat, id, input);
        return;
    }
    // A Hex with no cards to ask on lets it through, as it did before it was asked at all
    if (chat.approval == null) {
        leave_given(chat, id, input, true, null);
        return;
    }
    let detail = input.command ?? input.file_path ?? input.description ?? "";
    leave_asked[id] = chat.approval((request.display_name ?? tool) + " wants to run", detail, allowed => leave_given(chat, id, input, allowed, "The person said no."));
}

// How long its questions wait for the person before it's told to go on with its own pick
let question_seconds = 300;

// Its own AskUserQuestion, a card in the chat for each question with its options, the one it marks (Recommended) taken as
// its pick. Once every one is answered the answers go back in the tool's input, keyed by each question as it asked it.
// One nobody answers in time ends them all, the tool refused with word to go on with what it judges best
func asked_questions(chat, id, input) {
    let questions = input.questions ?? [];
    let state = { answers: {}, left: len(questions), over: false, cards: [] };
    if (state.left == 0) {
        leave_given(chat, id, input, true, null);
        return;
    }
    for (asked in questions) {
        let labels = [];
        let recommended = null;
        for (option in asked.options ?? []) {
            let label = option.label ?? "";
            if (recommended == null && label.ends_with("(Recommended)")) recommended = len(labels);
            labels.push(label);
        }
        let text = asked.question ?? "?";
        state.cards.push(chat.question(text, labels, recommended, question_seconds, answer => question_answered(chat, id, input, state, text, answer), asked.multiSelect == true));
    }
    leave_asked[id] = () => withdraw_questions(state);
}

// Every card of a tool's questions taken back, those answered already left as they are
func withdraw_questions(state) {
    state.over = true;
    for (withdraw in state.cards) withdraw();
}

// One of its questions answered, or with null left unanswered
func question_answered(chat, id, input, state, text, answer) {
    if (state.over) return;
    if (answer == null) {
        withdraw_questions(state);
        leave_given(chat, id, input, false, "Nobody answered in " + (question_seconds / 60) + " minutes. Go on with the option you judge best and say which you took.");
        return;
    }
    state.answers[text] = answer;
    state.left = state.left - 1;
    if (state.left > 0) return;
    state.over = true;
    input.answers = state.answers;
    leave_given(chat, id, input, true, null);
}

// The answer to a tool asked leave for, written on claude's stdin and the question forgotten
func leave_given(chat, id, input, allowed, message) {
    let said = allowed ? { behavior: "allow", updatedInput: input } : { behavior: "deny", message: message };
    chat.write({ type: "control_response", response: { subtype: "success", request_id: id, response: said } });
    leave_asked[id] = null;
}

// A message for claude's stdin, what somebody asked as a user's turn of stream-json, with the pictures pasted into it
// in front as image blocks so it sees them as it reads the words. A Hex without chat.images has none to give
func message_of(text, chat) {
    let message = user_message_of(text, chat);
    // The first message of a run goes with the handshake an SDK starts with, whose answer says its models and commands
    if (chat != null && introduce[chat.id] == true) {
        introduce[chat.id] = false;
        return [{ type: "control_request", request_id: "hex-init-" + chat.id, request: { subtype: "initialize" } }, message];
    }
    return message;
}

// The chats whose run hasn't been introduced yet, by the chat, set as each run starts
let introduce = {};

// What it said of itself the last time it was asked, its models for the picker and its slash commands
let discovered = { models: [], commands: [], said: "" };

// The answer to the handshake, its models in the picker by the names it gives them (Hex told again only when they changed)
func introduced(chat, said) {
    let models = [];
    for (model in said.models ?? []) {
        if (model.value == null) continue;
        models.push({ value: model.value == "default" ? "" : model.value, label: model.displayName ?? model.value, help: model.description });
    }
    let commands = discovered.commands;
    if (said.commands != null) {
        commands = [];
        for (command in said.commands) {
            if (command.name == null) continue;
            commands.push({ name: command.name, about: command.description ?? "", hint: command.argumentHint ?? "" });
            for (alias in command.aliases ?? [])
                commands.push({ name: alias, about: command.description ?? "", hint: command.argumentHint ?? "" });
        }
    }
    let key = models.map(each => each.value + "=" + each.label).join("|") + "#" + commands.map(each => each.name + "=" + each.about + "=" + each.hint).join("|");
    if ((len(models) == 0 && len(commands) == 0) || key == discovered.said) return;
    discovered.commands = commands;
    if (len(models) > 0) {
        discovered.models = models;
        // Kept for the next start, Claude Code's own list of the models the account may use, never written here by hand
        if (hex_of.hex != null) hex_of.hex.json_set(models_file(hex_of.hex), ["models"], models);
    }
    discovered.said = key;
    if (hex_of.hex != null) say_who(hex_of.hex);
}

// Where the models it said last are kept, in Hex's temp folder beside its context windows
func models_file(hex) { return hex.temp + "/claude-models.json"; }

// The options with the models it said in place of those written here, once it's said them
func options_now() {
    if (len(discovered.models) == 0) return options;
    let now = [{ id: "model", title: "Model", icon: "sparkle", choices: discovered.models }];
    for (each in options) if (each.id != "model") now.push(each);
    return now;
}

// The chats whose turn Hex asked to interrupt, by id, so the end of it isn't said to have failed
let interrupted = {};

// Its turn interrupted through its control protocol. Remembered: an interrupt asked for (Stop, or Send now getting a
// message through) ends the turn as an error_during_execution, which the chat showed as an error with Try again
func interrupt_of(chat) {
    interrupted["chat-" + chat.id] = true;
    return { type: "control_request", request_id: "hex-stop-" + chat.id, request: { subtype: "interrupt" } };
}

// A turn of the user's as stream-json
func user_message_of(text, chat) {
    let content = [];
    if (chat != null && chat.images != null) {
        for (image in chat.images()) content.push({ type: "image", source: { type: "base64", media_type: image.media_type, data: image.data } });
    }
    content.push({ type: "text", text: text });
    return { type: "user", message: { role: "user", content: content } };
}

// A line of claude's stream-json, what it says on the panel's rows
func heard(chat, event) {
    // It asks leave for a tool nothing else has said yes or no to. A read of the workspace by the shell is turned back at
    // once with the Hex tool for it, anything else asked of the person in the chat, the answer written back on its stdin
    if (event.type == "control_request" && event.request?.subtype == "can_use_tool") {
        asked_leave(chat, event.request_id, event.request);
        return;
    }
    if (event.type == "control_response") {
        let response = event.response ?? {};
        if ((response.request_id ?? "").starts_with("hex-init-") && response.subtype == "success") introduced(chat, response.response ?? {});
        return;
    }
    if (event.type == "control_cancel_request") {
        let withdraw = leave_asked[event.request_id];
        if (withdraw != null) withdraw();
        return;
    }
    // What a subagent of its own does comes with the id of the Task that started it, and goes on that Task's row as a
    // step rather than rows of its own among the chat's
    let parent = event.parent_tool_use_id;
    if (parent != null && chat.progress != null) {
        if (event.type == "assistant") {
            for (part in event.message?.content ?? []) {
                if (part.type == "tool_use") chat.progress(parent, step_of(part.name, part.input));
                else if (part.type == "text" && len(part.text.trim()) > 0) chat.progress(parent, part.text.trim().split("\n")[0]);
            }
        }
        return;
    }
    if (event.type == "system" && event.subtype == "init") {
        chat.session(event.session_id);
        // How much context the model has is only said as a turn ends, so a long first turn (a coordinator waiting on
        // its agents) would show no bar until it's over. The window this model had last time is said at once instead
        chat.usage({ model: event.model, context_limit: known_window(event.model) });
        return;
    }
    // Its context summed up to make room, by itself as it filled or because it was asked to with /compact. The
    // tokens it held before and after, after only from versions that say it
    if (event.type == "system" && event.subtype == "compact_boundary") {
        let compact = event.compact_metadata ?? {};
        if (chat.compacted != null) chat.compacted({ trigger: compact.trigger ?? "auto", before: compact.pre_tokens ?? 0, after: compact.post_tokens ?? 0 });
        else chat.note("context compacted");
        return;
    }
    // A call that failed and is tried again, overloaded, rate limited or a server error, with the wait before the next
    if (event.type == "system" && event.subtype == "api_retry") {
        let why = event.error ?? "";
        if (event.error_status != null) why = why + " (" + event.error_status + ")";
        if (chat.retry != null) chat.retry({ attempt: event.attempt ?? 1, most: event.max_retries ?? 0, delay: (event.retry_delay_ms ?? 0) / 1000, why: why.replace("_", " ") });
        return;
    }
    if (event.type == "system") return;
    // Where it stands against the plan's limits, said once a turn. The window that's binding when it's warned or
    // refused, the fullest of them otherwise, since that's the one that runs out first
    if (event.type == "rate_limit_event") {
        if (chat.limit != null) {
            // Every window it said, the session's and the week's each with its own bar, the binding one last so it's
            // the one the chat goes by
            let info = event.rate_limit_info ?? {};
            let binding = limit_of(info);
            let windows = info.unifiedWindows;
            if (windows != null) {
                for (name in keys(windows)) {
                    if (name != binding.kind) {
                        let window = windows[name];
                        chat.limit({ kind: name, status: window?.status ?? "allowed", used: window?.utilization ?? -1, resets: window?.resetsAt ?? 0, message: null });
                    }
                }
            }
            chat.limit(binding);
        }
        return;
    }
    if (event.type == "assistant") {
        // What it was reading as it said this, all of its context as of this call
        let call = event.message?.usage;
        if (call != null)
            chat.usage({ context: (call.input_tokens ?? 0) + (call.cache_read_input_tokens ?? 0) + (call.cache_creation_input_tokens ?? 0) });
        for (part in event.message?.content ?? []) {
            if (part.type == "text") chat.text(part.text);
            else if (part.type == "thinking") chat.thinking(part.thinking);
            else if (part.type == "tool_use" && part.name == "TodoWrite") {
                // Its to-do list as a checklist row, as Codex's is, rather than a tool row of JSON
                todos[part.id] = true;
                chat.note((part.input?.todos ?? []).map(todo => mark_of(todo.status) + todo.content).join("\n"));
                // And the same steps into the Plan tab, matched to the rows there, the call's id so it's taken once
                if (chat.plan != null)
                    chat.plan({ key: part.id, steps: (part.input?.todos ?? []).map(todo => ({ id: todo.id, text: todo.content, status: todo.status })) });
            }
            else if (part.type == "tool_use") chat.tool(part.id, part.name, part.input);
        }
        return;
    }
    if (event.type == "user") {
        if (said_by_command(event.message?.content)) {
            let content = event.message?.content;
            let output = typeof(content) == "text" ? content : (content ?? []).map(part => part?.text ?? "").join("");
            let failed = output.contains("<local-command-stderr>");
            let tag = failed ? "local-command-stderr" : "local-command-stdout";
            let from = output.index_of("<" + tag + ">") + len(tag) + 2;
            let to = output.index_of("</" + tag + ">");
            let body = to >= from ? output.substring(from, to).trim() : output;
            if (len(body) > 0) {
                if (failed) chat.error(body);
                else chat.note(body);
            }
            return;
        }
        // A message said back is one it took in, the first it was started with and every one asked as it worked
        if (event.isReplay ?? false) {
            // What a slash command printed comes back the same way, and wasn't asked as it worked
            if (!said_by_command(event.message?.content)) chat.taken();
            return;
        }
        // A message that is only text, the summary a compact starts the new context with, holds no tool results
        let parts = event.message?.content;
        if (typeof(parts) == "text") return;
        for (part in parts ?? []) {
            if (part.type == "tool_result" && todos[part.tool_use_id] != null) continue;
            if (part.type == "tool_result") chat.tool_done(part.tool_use_id, !(part.is_error ?? false), text_of(part.content));
        }
        return;
    }
    if (event.type == "result") {
        chat.session(event.session_id);
        let used = event.usage ?? {};
        chat.usage({ input: (used.input_tokens ?? 0) + (used.cache_read_input_tokens ?? 0) + (used.cache_creation_input_tokens ?? 0), output: used.output_tokens ?? 0, cost: event.total_cost_usd ?? 0,
            cache_read: used.cache_read_input_tokens ?? 0, context_limit: window_of(event.modelUsage) });
        let asked_to_stop = interrupted["chat-" + chat.id] == true;
        interrupted["chat-" + chat.id] = null;
        if (event.is_error && !(asked_to_stop && event.subtype == "error_during_execution")) chat.error(event.result ?? event.subtype);
        chat.done();
    }
}

// The to-do lists it wrote, by the id of the call, whose results say nothing worth a row
let todos = {};

// A to-do's box by how far it's got
func mark_of(status) {
    if (status == "completed") return "[x] ";
    if (status == "in_progress") return "[~] ";
    return "[ ] ";
}

// Whether a message said back is what a slash command printed rather than something asked
func said_by_command(content) {
    let text = typeof(content) == "text" ? content : (content ?? []).map(part => part?.text ?? "").join("");
    return text.contains("<local-command-stdout>") || text.contains("<local-command-stderr>");
}

// The limit a rate_limit_event says, in the words of chat.limit. The binding window when it's not all clear, the
// fullest of its windows when it is
func limit_of(info) {
    let kind = info.rateLimitType ?? "";
    let used = info.utilization ?? -1;
    let resets = info.resetsAt ?? 0;
    let windows = info.unifiedWindows;
    if (windows != null) {
        if ((info.status ?? "allowed") != "allowed" && windows[kind] != null) {
            used = windows[kind].utilization ?? used;
            resets = windows[kind].resetsAt ?? resets;
        } else {
            for (name in keys(windows)) {
                let window = windows[name];
                if ((window?.utilization ?? -1) > used) {
                    kind = name;
                    used = window.utilization;
                    resets = window.resetsAt ?? resets;
                }
            }
        }
    }
    let message = null;
    if (info.status == "rejected") message = "Claude Code waits for the limit to reset, or uses extra usage when it's on.";
    return { kind: kind, status: info.status ?? "allowed", used: used, resets: resets, message: message };
}

// How much context the models of a turn have, the most of them, 0 when it didn't say. Each one's kept for the next
// chat on it to know from its start
func window_of(models) {
    let most = 0;
    if (models == null) return most;
    for (name in keys(models)) {
        let window = models[name]?.contextWindow ?? 0;
        if (window > 0) remember_window(name, window);
        if (window > most) most = window;
    }
    return most;
}

// The context windows the models had, by name, kept in a file of Hex's temp folder so they last from run to run
let windows = { known: null };

func windows_file() { return hex_of.hex.temp + "/claude-windows.json"; }

func known_window(model) {
    if (model == null || hex_of.hex == null) return 0;
    if (windows.known == null) windows.known = read_cache(hex_of.hex, windows_file()) ?? {};
    let seen = windows.known[model];
    let window = typeof(seen) == "number" ? seen : 0;
    // A model asked for with [1m] has a million tokens whether or not it was seen before
    if (window == 0 && model.contains("[1m]")) window = 1000000;
    return window;
}

func remember_window(model, window) {
    if (hex_of.hex == null || known_window(model) == window) return;
    windows.known[model] = window;
    hex_of.hex.json_set(windows_file(), [model], window);
}

// A subagent's tool call said short, its name without the mcp__server__ in front and the part of what it was given
// that says most
func step_of(name, input) {
    let parts = name.split("__");
    let tool = parts[len(parts) - 1];
    let what = input?.description ?? input?.query ?? input?.pattern ?? input?.symbol ?? input?.command ?? input?.file_path ?? input?.path ?? input?.paths ?? input?.name ?? "";
    if (typeof(what) != "text") return tool;
    return tool + " " + what;
}

// What a tool said back, a text or a list of parts of which the texts are kept
func text_of(content) {
    if (typeof(content) == "text") return content;
    if (content == null) return "";
    let said = [];
    for (part in content) {
        if (part?.type == "text") said.push(part.text);
    }
    return said.join("\n");
}

// The first folder of the workspace, or null having said why
func folder_of(hex) {
    let folders = hex.workspace();
    if (len(folders) == 0) {
        hex.say("open a folder first, Claude Code is set up for a folder");
        return null;
    }
    return folders[0];
}

// The hex server in the folder's .mcp.json, the rest of the file left as it was
func connect(hex) {
    let folder = folder_of(hex);
    if (folder == null) return;
    let why = hex.json_set(folder + "/.mcp.json", ["mcpServers", hex.setting("server")], { command: hex.executable, args: ["--mcp"] });
    if (why != null) {
        hex.notify("couldn't write .mcp.json, " + why, true);
        return;
    }
    hex.notify("Claude Code started in " + folder + " has Hex's tools now, it asks to trust the server the first time");
}

// The block about the tools in the folder's CLAUDE.md, put in place of the one there or added at the end
func teach(hex) {
    let folder = folder_of(hex);
    if (folder == null) return;
    let file = folder + "/CLAUDE.md";
    hex.write(file, with_block(hex.exists(file) ? hex.read(file) : "", teach_start + "\n" + teaching + teach_end));
    hex.notify("CLAUDE.md says how to use Hex's tools now");
}

// Text with the block between the markers swapped for a new one, or added after a blank line when it has none
func with_block(text, block) {
    let from = text.index_of(teach_start);
    let to = text.index_of(teach_end);
    if (from >= 0 && to > from) return text.substring(0, from) + block + text.substring(to + len(teach_end));
    if (len(text) == 0) return block + "\n";
    return text.trim_end() + "\n\n" + block + "\n";
}
