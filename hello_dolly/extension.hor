let extension = {
    name: "Goodbye, Dolly!",
    description: "A random greeting in the title bar as Hex starts, and a new one every minute.",
    version: "1.2.0",
    author: "bogz"
};

// Greeting messages inspired by that stupid American movie...
// @doc The list of greetings
let welcome_greetings = [
	"You've been Hex'd :3",
	"Hello, Dolly!",
	"I wonder if you'll ever notice this, speed?",
