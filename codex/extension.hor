// Codex as an agent system of Hex's. Codex starts one MCP connection a chat and wants the editor open already, so it
// connects with --mcp-connect, which never opens a window of its own. From the Agents panel it runs codex exec --json,
// every item it says (a message, its reasoning, a command, a file changed, an MCP call, a search) a row there, with
// Hex's server handed to it by -c so its config needn't have it. Its config is the user's own, ~/.codex/config.toml, so
// connecting asks first and only ever adds the hex server, and teaching writes a few lines in the folder's AGENTS.md.
let extension = {
    name: "Codex",
    description: "Codex connected to Hex and run from the Agents panel, finding code through Hex's index instead of rg and whole files.",
    version: "1.7.0",
    author: "bogz",
    settings: {
        budget: { title: "Answer size", about: "The most characters a harness answer is for Codex when it doesn't say, about four to a token.", kind: "number", least: 1000, most: 60000, step: 1000, default: 6000 },
        program: { title: "Program", about: "The codex Hex runs from the Agents panel, a name on PATH or a whole path.", kind: "text", default: "codex" },
        model: { title: "Model", about: "The model it asks for, such as gpt-6.1-sol, its own default when empty.", kind: "text", default: "" },
        effort: { title: "Reasoning", about: "How hard it thinks, its own default when empty.", kind: "choice",
            choices: ["", "low", "medium", "high", "xhigh", "max"], labels: ["Default", "Low", "Medium", "High", "Extra high", "Max"], default: "" },
        sandbox: { title: "Sandbox", about: "What the commands it runs may touch.", kind: "choice",
            choices: ["workspace-write", "read-only", "danger-full-access"], labels: ["The workspace", "Read only", "Everything"],
            help: ["Writes in the workspace, reads anywhere.", "Reads, writes nothing.", "No sandbox at all, careful."], default: "workspace-write" }
    }
};

let instructions = "Find code through Hex before rg or reading whole files. hex_map to see the workspace, hex_symbols for declarations, hex_search for text (ranked, grouped by file), hex_refs for uses of a name, hex_skim for what files are, hex_read with a symbol for one method or class. Answers are path:line and end with the index generation, hex_changes says what moved since. hex_terminal_run runs a command and waits for it.";

// What the Agents panel offers over its box for Codex, each kept in the setting of its id. The models and efforts are the
// ones codex has cached for itself when that file is there, a fixed list of current ones when it isn't
// How much context each of the models codex has cached has, by its slug, for the Agents panel's details
let windows = {};

func options_for(hex) {
    let models = [{ value: "", label: "Default model" }];
    let efforts = [{ value: "", label: "Default effort" }];
    let known = ["low", "medium", "high", "xhigh", "max", "ultra"];
    let names = { low: "Low", medium: "Medium", high: "High", xhigh: "Extra high", max: "Max", ultra: "Ultra" };
    let seen = [];
    let cache = hex.home + "/.codex/models_cache.json";
    if (hex.exists(cache)) {
        let cached = hex.json_parse(hex.read(cache));
        for (model in cached?.models ?? []) {
            if (model.visibility != "list") continue;
            models.push({ value: model.slug, label: model.display_name ?? model.slug });
            windows[model.slug] = model.context_window ?? 0;
            for (level in model.supported_reasoning_levels ?? []) seen.push(level.effort);
        }
    }
    if (len(models) == 1) {
        for (slug in ["gpt-6.1-sol", "gpt-6-astra", "gpt-6.1-terra", "gpt-6-sol", "gpt-6-luna"]) models.push({ value: slug, label: slug });
        seen = ["low", "medium", "high", "xhigh", "max"];
    }
    for (level in known) if (seen.contains(level)) efforts.push({ value: level, label: names[level] });
    for (level in seen) if (!known.contains(level) && !efforts.map(each => each.value).contains(level)) efforts.push({ value: level, label: level });
    return [
        { id: "model", title: "Model", icon: "sparkle", choices: models },
        { id: "effort", title: "Reasoning", icon: "lightbulb", choices: efforts },
        { id: "sandbox", title: "Sandbox", icon: "shield", choices: [
            { value: "workspace-write", label: "Workspace" }, { value: "read-only", label: "Read only" }, { value: "danger-full-access", label: "Everything" }] }
    ];
}

let teach_start = "<!-- hex tools -->";
let teach_end = "<!-- /hex tools -->";
let teaching = "## Finding code\n\nThis folder is open in Hex, which Codex reaches as the `hex` MCP server. Use its tools before rg or reading whole files.\n\n- `hex_map`, `hex_files` for the layout, `hex_symbols` for declarations, `hex_refs` for uses\n- `hex_search` text or a regex, ranked and grouped by file\n- `hex_skim` what files are, `hex_read` with a symbol for one method or class\n- `hex_terminal_run` to run a command and wait, `hex_changes` for what moved since an answer\n";

// The hex object kept for the run's callbacks, which are only handed the chat and the line
let hex_of = { hex: null };

func on_start(hex) {
    hex_of.hex = hex;
    if (hex.agent == null) {
        hex.say("needs a Hex with the agent harness (hex.agent)");
        return;
    }
    say_who(hex);
    hex.command("Connect Codex to Hex", hex => connect(hex));
    hex.command("Teach Codex the Hex tools", hex => teach(hex));
}

func on_setting(hex, name, value) { say_who(hex); }

// Tells the harness who Codex is and how to run it, again whenever its settings change
func say_who(hex) {
    hex.agent({
        id: "codex",
        name: "Codex",
        clients: ["codex"],
        budget: hex.setting("budget"),
        instructions: instructions,
        run: {
            program: hex.setting("program"),
            icon: "terminal",
            install: "Install it with npm install -g @openai/codex, or say where it is in Codex's settings.",
            stdin: true,
            options: options_for(hex),
            arguments: (prompt, chat) => arguments_for(hex, chat),
            on_event: (chat, event) => heard(chat, event)
        }
    });
}

// What codex exec is run with for a turn, - for the prompt on its stdin, resume with the thread it was in so the chat
// goes on. Hex's server is given as config on the line, its paths with forward slashes so TOML takes them as they are,
// its calls given as long as hex_agent_wait waits (Codex gives up on a tool after a minute by itself), and switched on
// in case the user's own config has it off, its tools let through without asking since nobody's there to say yes
func arguments_for(hex, chat) {
    let server = hex.mcp_server(chat);
    let quoted = server.args.map(each => "\"" + each.replace("\\", "/") + "\"");
    let arguments = ["exec", "--json", "--skip-git-repo-check", "--sandbox", option(hex, chat, "sandbox"),
        "-c", "mcp_servers.hex.command=\"" + server.command.replace("\\", "/") + "\"",
        "-c", "mcp_servers.hex.args=[" + quoted.join(",") + "]",
        "-c", "mcp_servers.hex.tool_timeout_sec=660",
        "-c", "mcp_servers.hex.enabled=true",
        "-c", "mcp_servers.hex.default_tools_approval_mode=\"approve\""];
    // The harness said as developer instructions, where it weighs more than the server's, so finding and reading code
    // goes through Hex first and the shell is for the rest. A TOML literal string, the rules have no quotes to escape
    if (hex.harness_rules != null) {
        arguments.push("-c");
        arguments.push("developer_instructions='''" + hex.harness_rules + "'''");
    }
    let model = option(hex, chat, "model").trim();
    if (len(model) > 0) {
        arguments.push("--model");
        arguments.push(model);
    }
    let effort = option(hex, chat, "effort") ?? "";
    if (len(effort) > 0) {
        arguments.push("-c");
        arguments.push("model_reasoning_effort=\"" + effort + "\"");
    }
    let thread = chat.session();
    if (thread != null) {
        arguments.push("resume");
        arguments.push(thread);
    }
    // Pictures pasted into the message, by their files. Each its own --image= so the list doesn't take the - after it
    // for a picture as well. A Hex without chat.images has none to give
    if (chat.images != null) {
        for (image in chat.images()) arguments.push("--image=" + image.path);
    }
    arguments.push("-");
    return arguments;
}

// An option of the chat's when it was started with one (an agent starting it with a model), the setting otherwise
func option(hex, chat, id) {
    return chat.option(id) ?? hex.setting(id);
}

// A line of codex exec --json, what it says on the panel's rows
func heard(chat, event) {
    let item = event.item;
    if (event.type == "thread.started") {
        chat.session(event.thread_id);
        begin_log(chat, event.thread_id);
    }
    else if (event.type == "item.started" && item != null) started(chat, item);
    else if (event.type == "item.completed" && item != null) {
        completed(chat, item);
        read_log(chat);
    }
    else if (event.type == "turn.completed") {
        read_log(chat);
        let used = event.usage ?? {};
        chat.usage({ input: used.input_tokens ?? 0, output: used.output_tokens ?? 0, cache_read: used.cached_input_tokens ?? 0, context_limit: windows[chat.option("model") ?? ""] ?? 0 });
        chat.done();
    }
    else if (event.type == "turn.failed") {
        read_log(chat);
        let message = event.error?.message ?? "the turn failed";
        if (!limit_said(chat, message)) chat.error(message);
        chat.done();
    }
    // Warnings come as errors too, a turn that fails says so with turn.failed. A dropped stream it tries again says
    // Reconnecting with the try and how many it makes, a retry rather than something wrong
    else if (event.type == "error") {
        let message = event.message ?? "something went wrong";
        if (!retry_said(chat, message) && !limit_said(chat, message)) chat.note(message);
    }
}

// What codex exec --json leaves out (where it stands against its limits, its context compacted, how big its window
// is) is in the session file it writes for every thread, ~/.codex/sessions/.../rollout-...-<thread>.jsonl. Each chat
// reads on from where it got to, so a turn costs only the lines it added
let logs = {};

// A thread resumed has a session file already, with the compactions and limits of turns said before, so this turn's
// reading starts at its end. A new thread's file is written as it goes, read from its start
func begin_log(chat, thread) {
    if (hex_of.hex == null || hex_of.hex.find_file == null) return;
    let file = hex_of.hex.find_file(hex_of.hex.home + "/.codex/sessions", thread + ".jsonl");
    logs[chat.id] = { thread: thread, file: file, at: file == null ? 0 : hex_of.hex.read_lines(file, -1).end, context: 0, compacting: -1, tries: 0 };
}

func read_log(chat) {
    let thread = chat.session();
    if (thread == null || chat.limit == null || hex_of.hex == null || hex_of.hex.read_lines == null) return;
    let log = logs[chat.id];
    if (log == null || log.thread != thread) {
        log = { thread: thread, file: null, at: 0, context: 0, compacting: -1, tries: 0 };
        logs[chat.id] = log;
    }
    if (log.file == null) {
        // Looked for a few times only, a thread whose file isn't where it's expected costs nothing after that
        if (log.tries > 3) return;
        log.tries = log.tries + 1;
        log.file = hex_of.hex.find_file(hex_of.hex.home + "/.codex/sessions", thread + ".jsonl");
        if (log.file == null) return;
    }
    let read = hex_of.hex.read_lines(log.file, log.at);
    log.at = read.end;
    for (line in read.lines) {
        // Only the kinds of line wanted are parsed, the rest of the file is the whole conversation
        if (line.contains("\"token_count\"")) counted(chat, log, hex_of.hex.json_parse(line)?.payload);
        else if (line.index_of("\"type\":\"compacted\"") >= 0 && line.index_of("\"type\":\"compacted\"") < 120) log.compacting = log.context;
    }
}

// A token_count of the session file, how full the context is, how big the window is and where the limits stand
func counted(chat, log, payload) {
    if (payload == null) return;
    let info = payload.info;
    let context = info?.last_token_usage?.input_tokens ?? 0;
    if (context > 0) {
        if (log.compacting >= 0) {
            chat.compacted({ trigger: "auto", before: log.compacting, after: context });
            log.compacting = -1;
        }
        log.context = context;
        chat.usage({ context: context, context_limit: info?.model_context_window ?? 0 });
    }
    let limits = payload.rate_limits;
    if (limits != null) chat.limit(limit_of(limits));
}

// The fuller of the two windows Codex keeps, the five hour one and the weekly one, as chat.limit says it. Codex says
// no warning of its own, so one goes up past nine tenths
func limit_of(limits) {
    let window = limits.primary;
    if (limits.secondary != null && (window == null || (limits.secondary.used_percent ?? 0) > (window.used_percent ?? 0))) window = limits.secondary;
    let used = (window?.used_percent ?? -100) / 100;
    let minutes = window?.window_minutes ?? 0;
    let kind = minutes >= 10000 ? "seven_day" : minutes == 300 ? "five_hour" : "usage";
    let status = limits.rate_limit_reached_type != null ? "rejected" : used >= 0.9 ? "allowed_warning" : "allowed";
    return { kind: kind, status: status, used: used, resets: window?.resets_at ?? 0 };
}

// Reconnecting... 2/5 said as a retry, true when it was one
func retry_said(chat, message) {
    if (chat.retry == null || !message.starts_with("Reconnecting")) return false;
    let tries = message.split(" ");
    let counts = tries[len(tries) - 1].split("/");
    let attempt = len(counts) == 2 ? number(counts[0]) ?? 1 : 1;
    let most = len(counts) == 2 ? number(counts[1].split(" ")[0]) ?? 0 : 0;
    chat.retry({ attempt: attempt, most: most, why: "stream dropped" });
    return true;
}

// A usage limit hit said as the limit it is, the time it resets as Codex says it in its words, true when it was one
func limit_said(chat, message) {
    if (chat.limit == null) return false;
    let low = message.lower();
    if (!low.contains("usage limit") && !low.contains("rate limit") && !low.contains("quota")) return false;
    chat.limit({ kind: low.contains("rate limit") ? "rate" : "usage", status: "rejected", message: message });
    return true;
}

// An item that takes a while, a row that's running until it's completed
func started(chat, item) {
    if (item.type == "command_execution") chat.tool(item.id, "command", item.command);
    else if (item.type == "mcp_tool_call") chat.tool(item.id, "mcp__" + item.server + "__" + item.tool, item.arguments ?? "");
    else if (item.type == "web_search") chat.tool(item.id, "web_search", item.query ?? "");
    else if (item.type == "file_change") chat.tool(item.id, "file_change", changes_of(item));
}

func completed(chat, item) {
    if (item.type == "agent_message") chat.text(item.text ?? "");
    else if (item.type == "reasoning") chat.thinking(item.text ?? "");
    else if (item.type == "command_execution") chat.tool_done(item.id, item.exit_code == 0, item.aggregated_output ?? "");
    else if (item.type == "mcp_tool_call") chat.tool_done(item.id, item.status != "failed", item.result ?? item.error ?? "");
    else if (item.type == "web_search") chat.tool_done(item.id, true, item.query ?? "");
    else if (item.type == "file_change") {
        // Codex says a file change once it's made, so its row starts and ends here
        chat.tool(item.id, "file_change", changes_of(item));
        chat.tool_done(item.id, item.status != "failed", changes_of(item));
    }
    else if (item.type == "todo_list") chat.note((item.items ?? []).map(each => (each.completed ? "[x] " : "[ ] ") + each.text).join("\n"));
    // Codex says its warnings as error items, so they're notes and only turn.failed fails the turn
    else if (item.type == "error") chat.note(item.message ?? "something went wrong");
}

// What a file change changed, a line a file with how
func changes_of(item) {
    return (item.changes ?? []).map(change => change.kind + " " + change.path).join("\n");
}

// The hex server added to ~/.codex/config.toml, after asking since it's the user's file and not the folder's
func connect(hex) {
    let config = hex.home + "/.codex/config.toml";
    let text = hex.exists(config) ? hex.read(config) : "";
    if (text.contains("[mcp_servers.hex]")) {
        hex.notify("Codex has a hex server already, in " + config);
        return;
    }
    hex.ask({ title: "Connect Codex", text: "Add the hex server to " + config + "? Hex has to be open with its MCP server on for Codex to reach it.", buttons: ["Add it", "Cancel"] }, (hex, pressed) => {
        if (pressed != "Add it") return;
        let section = "[mcp_servers.hex]\ncommand = '" + hex.executable + "'\nargs = [\"--mcp-connect\"]\n";
        hex.write(config, len(text) == 0 ? section : text.trim_end() + "\n\n" + section);
        hex.notify("Codex reaches Hex as the hex server from its next chat");
    });
}

// The block about the tools in the folder's AGENTS.md, put in place of the one there or added at the end
func teach(hex) {
    let folders = hex.workspace();
    if (len(folders) == 0) {
        hex.say("open a folder first");
        return;
    }
    let file = folders[0] + "/AGENTS.md";
    let text = hex.exists(file) ? hex.read(file) : "";
    let block = teach_start + "\n" + teaching + teach_end;
    let from = text.index_of(teach_start);
    let to = text.index_of(teach_end);
    if (from >= 0 && to > from) text = text.substring(0, from) + block + text.substring(to + len(teach_end));
    else if (len(text) == 0) text = block + "\n";
    else text = text.trim_end() + "\n\n" + block + "\n";
    hex.write(file, text);
    hex.notify("AGENTS.md says how to use Hex's tools now");
}
