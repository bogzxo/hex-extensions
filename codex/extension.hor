// Codex as an agent system of Hex's. Codex starts one MCP connection a chat and wants the editor open already, so it
// connects with --mcp-connect, which never opens a window of its own. From the Agents panel it runs codex app-server,
// a conversation of JSON lines, every item it says (a message, its reasoning, a command, a file changed, an MCP call, a
// search) a row there, its commands asked of Hex first, with Hex's server handed to it by -c so its config needn't have it. Its config is the user's own, ~/.codex/config.toml, so
// connecting asks first and only ever adds the hex server, and teaching writes a few lines in the folder's AGENTS.md.
let extension = {
    name: "Codex",
    description: "Codex connected to Hex and run from the Agents panel, finding code through Hex's index instead of rg and whole files.",
    version: "1.9.0",
    author: "bogz",
    settings: {
        budget: { title: "Answer size", about: "The most characters a harness answer is for Codex when it doesn't say, about four to a token.", kind: "number", least: 1000, most: 60000, step: 1000, default: 6000 },
        program: { title: "Program", about: "The codex Hex runs from the Agents panel, a name on PATH or a whole path.", kind: "text", default: "codex" },
        model: { title: "Model", about: "The model it asks for, such as gpt-6.1-sol, its own default when empty.", kind: "text", default: "" },
        effort: { title: "Reasoning", about: "How hard it thinks, its own default when empty.", kind: "choice",
            choices: ["", "low", "medium", "high", "xhigh", "max"], labels: ["Default", "Low", "Medium", "High", "Extra high", "Max"], default: "" },
        sandbox: { title: "Sandbox", about: "What the commands it runs may touch.", kind: "choice",
            choices: ["workspace-write", "read-only", "danger-full-access"], labels: ["The workspace", "Read only", "Everything"],
            help: ["Writes in the workspace, reads anywhere.", "Reads, writes nothing.", "No sandbox at all, careful."], default: "workspace-write" }
    }
};

let instructions = "Find code through Hex before rg or reading whole files. hex_map to see the workspace, hex_symbols for declarations, hex_search for text (ranked, grouped by file), hex_refs for uses of a name, hex_skim for what files are, hex_read with a symbol for one method or class. Answers are path:line and end with the index generation, hex_changes says what moved since. hex_terminal_run runs a command and waits for it.";

// What the Agents panel offers over its box for Codex, each kept in the setting of its id. The models and efforts are the
// ones codex has cached for itself when that file is there, a fixed list of current ones when it isn't
// How much context each of the models codex has cached has, by its slug, for the Agents panel's details
let windows = {};

// Its models by the names it gives them, from its own cache, handed to Hex with each chat so they're said in full
let model_names = { list: [] };

func options_for(hex) {
    model_names.list = [];
    let models = [{ value: "", label: "Default model" }];
    let efforts = [{ value: "", label: "Default effort" }];
    let known = ["low", "medium", "high", "xhigh", "max", "ultra"];
    let names = { low: "Low", medium: "Medium", high: "High", xhigh: "Extra high", max: "Max", ultra: "Ultra" };
    let seen = [];
    let cache = hex.home + "/.codex/models_cache.json";
    if (hex.exists(cache)) {
        let cached = hex.json_parse(hex.read(cache));
        for (model in cached?.models ?? []) {
            if (model.visibility != "list") continue;
            models.push({ value: model.slug, label: model.display_name ?? model.slug });
            if (model.display_name != null) model_names.list.push({ id: model.slug, name: model.display_name });
            windows[model.slug] = model.context_window ?? 0;
            for (level in model.supported_reasoning_levels ?? []) seen.push(level.effort);
        }
    }
    // What it said itself over its cache file, once a run has asked it
    if (len(listed_models.list) > 0) {
        models = [{ value: "", label: "Default model" }];
        for (model in listed_models.list) models.push(model);
    }
    if (len(models) == 1) {
        for (slug in ["gpt-6.1-sol", "gpt-6-astra", "gpt-6.1-terra", "gpt-6-sol", "gpt-6-luna"]) models.push({ value: slug, label: slug });
        seen = ["low", "medium", "high", "xhigh", "max"];
    }
    for (level in known) if (seen.contains(level)) efforts.push({ value: level, label: names[level] });
    for (level in seen) if (!known.contains(level) && !efforts.map(each => each.value).contains(level)) efforts.push({ value: level, label: level });
    return [
        { id: "model", title: "Model", icon: "sparkle", choices: models },
        { id: "effort", title: "Reasoning", icon: "lightbulb", choices: efforts },
        { id: "sandbox", title: "Sandbox", icon: "shield", choices: [
            { value: "workspace-write", label: "Workspace" }, { value: "read-only", label: "Read only" }, { value: "danger-full-access", label: "Everything" }] }
    ];
}

let teach_start = "<!-- hex tools -->";
let teach_end = "<!-- /hex tools -->";
let teaching = "## Finding code\n\nThis folder is open in Hex, which Codex reaches as the `hex` MCP server. Use its tools before rg or reading whole files.\n\n- `hex_map`, `hex_files` for the layout, `hex_symbols` for declarations, `hex_refs` for uses\n- `hex_search` text or a regex, ranked and grouped by file\n- `hex_skim` what files are, `hex_read` with a symbol for one method or class\n- `hex_terminal_run` to run a command and wait, `hex_changes` for what moved since an answer\n";

// The hex object kept for the run's callbacks, which are only handed the chat and the line
let hex_of = { hex: null };

func on_start(hex) {
    hex_of.hex = hex;
    if (hex.agent == null) {
        hex.say("needs a Hex with the agent harness (hex.agent)");
        return;
    }
    // The models it said the last time, the picker made of them from the start
    if (hex.exists(models_file(hex))) {
        let kept = hex.json_parse(hex.read(models_file(hex)))?.models ?? [];
        if (len(kept) > 0) listed_models.list = kept;
    }
    say_who(hex);
    hex.command("Connect Codex to Hex", hex => connect(hex));
    hex.command("Teach Codex the Hex tools", hex => teach(hex));
}

func on_setting(hex, name, value) { say_who(hex); }

// Tells the harness who Codex is and how to run it, again whenever its settings change
func say_who(hex) {
    hex.agent({
        id: "codex",
        name: "Codex",
        // OpenAI's black and white, the light of it on a dark theme and the dark on a light one, for its badge
        colour: "#ECECEC",
        colour_light: "#0D0D0D",
        clients: ["codex"],
        budget: hex.setting("budget"),
        instructions: instructions,
        run: {
            program: hex.setting("program"),
            icon: "terminal",
            install: "Install it with npm install -g @openai/codex, or say where it is in Codex's settings.",
            stdin: true,
            options: options_for(hex),
            arguments: (prompt, chat) => arguments_for(hex, chat),
            message: (text, chat) => message_of(hex, text, chat),
            // Stop interrupts the turn going on, its thread left whole, nothing said when there's none (it's killed)
            stop: chat => stop_of(chat),
            // The message Hex compacts with, turned into thread/compact/start once the thread is taken up
            compact: "/compact",
            commands: commands_now(),
            strict_commands: true,
            on_event: (chat, event) => heard(chat, event)
        }
    });
}

// The app-server has structured requests, not the terminal's slash parser.
let listed_skills = { list: [] };
func commands_now() {
    let commands = [
        { name: "compact", about: "Summarize this thread to free context." },
        { name: "review", about: "Review uncommitted changes, or follow custom review instructions.", hint: "[instructions]" },
        { name: "skills", about: "Refresh and list the skills available in this workspace." },
        { name: "mcp", about: "List the connected MCP servers and their authentication status." }
    ];
    for (skill in listed_skills.list)
        if (!commands.map(each => each.name).contains(skill.name))
            commands.push({ name: skill.name, about: skill.interface?.shortDescription ?? skill.shortDescription ?? skill.description ?? "", hint: "[arguments]" });
    return commands;
}

func slash_of(text) {
    let trimmed = text.trim();
    if (!trimmed.starts_with("/")) return null;
    let head = trimmed.split(" ")[0].split("\t")[0].split("\r")[0].split("\n")[0];
    if (len(head) < 2) return null;
    let name = head.substring(1);
    if (name.contains("/") || name.contains("\\")) return null;
    return { name: name.lower(), arguments: trimmed.substring(len(head)).trim() };
}

func skills_listed(chat, said, data) {
    said.skills = [];
    for (entry in data)
        for (skill in entry.skills ?? [])
            if (skill.enabled != false && skill.name != null && skill.path != null) said.skills.push(skill);
    said.skills_ready = true;
    listed_skills.list = said.skills;
    if (hex_of.hex != null) say_who(hex_of.hex);
    if (said.command?.name == "skills") {
        chat.text(len(said.skills) == 0 ? "No enabled skills were found." : said.skills.map(skill => "/" + skill.name + " — " + (skill.description ?? "")).join("\n"));
        chat.done();
    }
    else start_requested(chat, said);
}

// A command is dispatched only after its prerequisites have arrived, regardless of response order.
func start_requested(chat, said) {
    if (said.ready != true || said.sent == true) return;
    let command = said.command;
    if (command?.name == "skills" || command?.name == "mcp") return;
    if (command != null && command.name != "compact" && command.name != "review" && said.skills_ready != true) return;
    said.sent = true;
    if (command?.name == "compact") {
        if (len(command.arguments) > 0) { chat.error("/compact does not take arguments in Codex."); chat.done(); return; }
        chat.write({ id: 3, method: "thread/compact/start", params: { threadId: said.thread } });
        return;
    }
    if (command?.name == "review") {
        let target = len(command.arguments) == 0 ? { type: "uncommittedChanges" } : { type: "custom", instructions: command.arguments };
        chat.write({ id: 3, method: "review/start", params: { threadId: said.thread, target: target, delivery: "inline" } });
        return;
    }
    let input = input_of(said.prompt ?? "", said.images);
    if (command != null) {
        let found = said.skills.filter(skill => skill.name.lower() == command.name);
        if (len(found) == 0) { chat.error("Unknown or unavailable Codex command /" + command.name + ". Use /skills to refresh the list."); chat.done(); return; }
        let skill = found[0];
        let mention = "$" + skill.name;
        if (len(command.arguments) > 0) mention = mention + " " + command.arguments;
        input = [{ type: "text", text: mention }, { type: "skill", name: skill.name, path: skill.path }];
    }
    let turn = { threadId: said.thread, input: input, model: model_of(hex_of.hex, chat) };
    let effort = option(hex_of.hex, chat, "effort") ?? "";
    if (len(effort) > 0) turn.effort = effort;
    chat.write({ id: 3, method: "turn/start", params: turn });
}

// What codex is run with for a turn, its app-server, a conversation of JSON lines on its stdin and stdout rather than a
// prompt in and lines out. It's told what Hex is doing as it works (steered with turn/steer), asks before each command,
// which Hex answers (declining a read or a search of the workspace the long way so it uses the hex tools), and says
// where it stands against its limits, its tokens and its compactions as they happen. Hex's server is given as config on
// the line, its paths with forward slashes so TOML takes them as they are, its calls given as long as hex_agent_wait
// waits, switched on in case the user's own config has it off, and its tools let through without asking
func arguments_for(hex, chat) {
    conversation_of(chat, true);
    let server = hex.mcp_server(chat);
    let quoted = server.args.map(each => "\"" + each.replace("\\", "/") + "\"");
    let arguments = ["app-server",
        "-c", "mcp_servers.hex.command=\"" + server.command.replace("\\", "/") + "\"",
        "-c", "mcp_servers.hex.args=[" + quoted.join(",") + "]",
        "-c", "mcp_servers.hex.tool_timeout_sec=660",
        "-c", "mcp_servers.hex.enabled=true",
        "-c", "mcp_servers.hex.env_vars=[\"HEX_HOME\"]",
        "-c", "mcp_servers.hex.default_tools_approval_mode=\"approve\""];
    let effort = option(hex, chat, "effort") ?? "";
    if (len(effort) > 0) {
        arguments.push("-c");
        arguments.push("model_reasoning_effort=\"" + effort + "\"");
    }
    return arguments;
}

// An option of the chat's when it was started with one (an agent starting it with a model), the setting otherwise
func option(hex, chat, id) {
    return chat.option(id) ?? hex.setting(id);
}

// Where each chat's conversation with its app-server is, by the chat. Started again with each turn's process: the thread
// it's in, the turn going on, the number of the next request, what it's to be asked once its thread is ready, the
// tokens it had said by the last count so each count adds only what's new, and how many messages it's taken in
let conversations = {};

func conversation_of(chat, fresh) {
    let said = conversations[chat.id];
    if (said == null || fresh) {
        said = { thread: chat.session(), turn: null, next: 10, prompt: null, images: [], input: 0, output: 0, cached: 0, taken: 0, steers: {}, skills: [], skills_ready: false, ready: false, sent: false, command: null };
        conversations[chat.id] = said;
    }
    return said;
}

// The models it said it has (model/list), their names to Hex and the picker made of them, Hex told again only when
// they're not what it had
let listed_models = { list: [], said: "" };

func models_listed(chat, data) {
    let models = [];
    let names = [];
    for (model in data) {
        let id = model.model ?? model.id;
        if (id == null || model.hidden == true) continue;
        let name = model.displayName ?? id;
        models.push({ value: id, label: name, help: model.description });
        if (name != id) names.push({ id: id, name: name });
    }
    if (len(models) == 0) return;
    if (chat.models != null) chat.models(names);
    let key = models.map(each => each.value + "=" + each.label).join("|");
    if (key == listed_models.said) return;
    listed_models.said = key;
    listed_models.list = models;
    if (hex_of.hex != null) {
        // Kept for the next start, so the picker has Codex's own list from the start rather than once a run has asked
        hex_of.hex.json_set(models_file(hex_of.hex), ["models"], models);
        say_who(hex_of.hex);
    }
}

// Where the models it said last are kept, in Hex's temp folder
func models_file(hex) { return hex.temp + "/codex-models.json"; }

// The turn going on interrupted, null with no turn to interrupt
func stop_of(chat) {
    let said = conversation_of(chat, false);
    if (said.turn == null || said.thread == null) return null;
    said.next = said.next + 1;
    return { id: said.next, method: "turn/interrupt", params: { threadId: said.thread, turnId: said.turn } };
}

// What goes on its stdin when something's asked. The start of a turn is the handshake and the thread, started or taken
// up again, the turn itself going once the thread's said ready (heard). Asked while a turn's going, it's steered into it
func message_of(hex, text, chat) {
    let said = conversation_of(chat, false);
    if (chat.models != null) chat.models(model_names.list);
    let images = chat.images != null ? chat.images() : [];
    if (said.turn != null) {
        said.next = said.next + 1;
        if (chat.steer_result != null) said.steers["request_" + said.next] = text;
        return { id: said.next, method: "turn/steer", params: { threadId: said.thread, expectedTurnId: said.turn, input: input_of(text, images) } };
    }

    said.prompt = text;
    said.command = slash_of(text);
    said.images = images;
    // /compact sums up the thread's context once it's taken up, in place of a turn
    said.compact = text.trim() == "/compact" && said.thread != null;
    let rules = (hex.harness_rules ?? "") + "\n" + (hex.plan_rules != null ? hex.plan_rules + "\n" : "") + instructions;
    let thread = said.thread != null
        ? { id: 2, method: "thread/resume", params: { threadId: said.thread, approvalPolicy: "untrusted", sandbox: option(hex, chat, "sandbox"), developerInstructions: rules, excludeTurns: true } }
        : { id: 2, method: "thread/start", params: { approvalPolicy: "untrusted", sandbox: option(hex, chat, "sandbox"), cwd: chat.folder, developerInstructions: rules, model: model_of(hex, chat), ephemeral: false } };
    let opening = [
        { id: 1, method: "initialize", params: { clientInfo: { name: "hex", title: "Hex", version: "1" }, capabilities: { experimentalApi: true } } },
        { method: "initialized" },
        // Its models as it has them now, the picker and their names put right by the answer (heard)
        { id: 4, method: "model/list", params: {} },
        { id: 5, method: "skills/list", params: { cwds: [chat.folder], forceReload: true } }
    ];
    if (said.command?.name == "mcp") opening.push({ id: 6, method: "mcpServerStatus/list", params: {} });
    else if (said.command?.name != "skills") opening.push(thread);
    return opening;
}

// The model asked for, null for its own default
func model_of(hex, chat) {
    let model = (option(hex, chat, "model") ?? "").trim();
    return len(model) > 0 ? model : null;
}

// What's asked as the app-server takes it, the words and the pictures pasted with them by their files
func input_of(text, images) {
    let input = [{ type: "text", text: text }];
    for (image in images) input.push({ type: "localImage", path: image.path });
    return input;
}

// A line of the app-server, an answer to something Hex asked, something it asks Hex, or something it says
func heard(chat, event) {
    let said = conversation_of(chat, false);
    if (event.method == null) {
        answered(chat, said, event);
        return;
    }
    if (event.id != null) {
        asked(chat, said, event);
        return;
    }
    let params = event.params ?? {};
    let method = event.method;
    if (method == "item/started") started(chat, said, params.item);
    else if (method == "item/completed") completed(chat, params.item);
    else if (method == "turn/completed") {
        said.turn = null;
        let turn = params.turn ?? {};
        if (turn.status == "failed") {
            let message = turn.error?.message ?? "the turn failed";
            if (!limit_said(chat, message)) chat.error(message);
        }
        chat.done();
    }
    // Its own plan, structured, its steps in the Plan tab beside what hex_plan_update wrote. The prose plan item stays a note
    else if (method == "turn/plan/updated") {
        if (chat.plan != null)
            chat.plan({ steps: (params.plan ?? []).map(step => ({ text: step.step, status: step.status })) });
    }
    else if (method == "thread/tokenUsage/updated") counted(chat, said, params.tokenUsage);
    else if (method == "account/rateLimits/updated") limits_said(chat, params.rateLimits);
    else if (method == "thread/compacted") {
        chat.compacted({ trigger: said.compact == true ? "manual" : "auto" });
        // Compacting as asked is all there is to that turn, ended here should no turn/completed follow
        if (said.compact == true && said.turn == null) {
            said.compact = false;
            chat.done();
        }
    }
    else if (method == "error") {
        let message = params.error?.message ?? "something went wrong";
        if (params.willRetry == true) chat.retry({ attempt: 0, why: message });
        else if (!limit_said(chat, message)) chat.note(message);
    }
}

// An answer to Hex's own request, the thread it's in (the turn asked for then) or the turn started
func answered(chat, said, event) {
    let key = "request_" + event.id;
    let steered = said.steers[key];
    if (steered != null) {
        said.steers[key] = null;
        chat.steer_result(steered, event.error == null);
        if (event.error != null) chat.note(event.error.message ?? "Codex rejected the queued message.");
        // A completed turn may have been waiting on this response to resolve its last queued message.
        if (said.turn == null) chat.done();
        return;
    }
    if (event.error != null) {
        if (event.id == 5) {
            said.skills_ready = true;
            if (said.command?.name == "skills") { chat.error(event.error.message ?? "Skills are unavailable."); chat.done(); }
            else start_requested(chat, said);
            return;
        }
        let message = event.error.message ?? "the app-server said no";
        if (!limit_said(chat, message)) chat.error(message);
        if (event.id == 1 || event.id == 2 || event.id == 3 || event.id == 6) chat.done();
        return;
    }
    let result = event.result ?? {};
    if (event.id == 4) {
        models_listed(chat, result.data ?? []);
        return;
    }
    if (event.id == 5) { skills_listed(chat, said, result.data ?? []); return; }
    if (event.id == 6) {
        for (server in result.data ?? []) chat.note(server.name + " — " + (server.authStatus ?? "connected"));
        if (result.nextCursor != null) chat.write({ id: 6, method: "mcpServerStatus/list", params: { cursor: result.nextCursor } });
        else chat.done();
        return;
    }
    if (event.id == 2) {
        said.thread = result.thread?.id ?? said.thread;
        if (said.thread != null) chat.session(said.thread);
        said.ready = true;
        start_requested(chat, said);
    }
    else if (event.id == 3) said.turn = result.turn?.id;
}

// Something the app-server asks Hex, a command to run or a file to change. A read or a search of the workspace by the
// shell is declined so it goes to the hex tools instead, anything else let through, Hex having the person's word
// already in the sandbox it was started with
func asked(chat, said, event) {
    let params = event.params ?? {};
    if (event.method == "item/commandExecution/requestApproval") {
        let instead = hex_of.hex?.harness_check != null ? hex_of.hex.harness_check(script_of(params.command ?? "")) : null;
        if (instead != null) chat.note("$(shield) Turned back to Hex's tools: " + script_of(params.command ?? "") + ", " + instead);
        chat.write({ id: event.id, result: { decision: instead != null ? "decline" : "accept" } });
    }
    else if (event.method == "item/fileChange/requestApproval") chat.write({ id: event.id, result: { decision: "accept" } });
    else if (event.method == "mcpServer/elicitation/request") chat.write({ id: event.id, result: { action: "accept" } });
    else chat.write({ id: event.id, error: { code: -32601, message: "Hex doesn't answer " + event.method } });
}

// The script a command runs, out of the shell it's wrapped in on Windows, "...powershell.exe" -Command 'ls'
func script_of(command) {
    let at = command.index_of("-Command ");
    if (at < 0) return command;
    let script = command.substring(at + 9).trim();
    if (script.starts_with("'") && script.ends_with("'") && len(script) >= 2) script = script.substring(1, len(script) - 1);
    else if (script.starts_with("\"") && script.ends_with("\"") && len(script) >= 2) script = script.substring(1, len(script) - 1);
    return script;
}

// How many tokens it's used, said whole each time, so only what's new since the last count is added
func counted(chat, said, usage) {
    if (usage == null) return;
    let total = usage.total ?? {};
    let input = total.inputTokens ?? 0;
    let output = total.outputTokens ?? 0;
    let cached = total.cachedInputTokens ?? 0;
    let context = usage.last?.inputTokens ?? 0;
    chat.usage({ input: input > said.input ? input - said.input : 0, output: output > said.output ? output - said.output : 0, cache_read: cached > said.cached ? cached - said.cached : 0,
        context: context, context_limit: usage.modelContextWindow ?? windows[chat.option("model") ?? ""] ?? 0 });
    said.input = input;
    said.output = output;
    said.cached = cached;
}

// Where it stands against its plan's limits, each of its windows as chat.limit says it, the five hour one and the week.
// Codex says no warning of its own, so one goes up past nine tenths
func limits_said(chat, limits) {
    if (limits == null || chat.limit == null) return;
    for (window in [limits.primary, limits.secondary]) {
        if (window == null) continue;
        let used = (window.usedPercent ?? -100) / 100;
        let minutes = window.windowDurationMins ?? 0;
        let kind = minutes >= 10000 ? "seven_day" : minutes == 300 ? "five_hour" : "usage";
        let status = limits.rateLimitReachedType != null && used >= 1 ? "rejected" : used >= 0.9 ? "allowed_warning" : "allowed";
        chat.limit({ kind: kind, status: status, used: used, resets: window.resetsAt ?? 0 });
    }
}

// A usage limit hit said as the limit it is, the time it resets as Codex says it in its words, true when it was one
func limit_said(chat, message) {
    if (chat.limit == null) return false;
    let low = message.lower();
    if (!low.contains("usage limit") && !low.contains("rate limit") && !low.contains("quota")) return false;
    chat.limit({ kind: low.contains("rate limit") ? "rate" : "usage", status: "rejected", message: message });
    return true;
}

// An item that takes a while, a row that's running until it's completed. What somebody said while it worked is a user
// message after the first, which the panel's queued bubble was waiting for
func started(chat, said, item) {
    if (item == null) return;
    if (item.type == "userMessage") {
        said.taken = said.taken + 1;
        if (chat.steer_result == null && said.taken > 1) chat.taken();
    }
    else if (item.type == "commandExecution") chat.tool(item.id, "command", script_of(item.command ?? ""));
    else if (item.type == "mcpToolCall") chat.tool(item.id, "mcp__" + item.server + "__" + item.tool, item.arguments ?? "");
    else if (item.type == "webSearch") chat.tool(item.id, "web_search", item.query ?? "");
    else if (item.type == "fileChange") chat.tool(item.id, "file_change", changes_of(item));
}

func completed(chat, item) {
    if (item == null) return;
    if (item.type == "agentMessage") chat.text(item.text ?? "");
    else if (item.type == "reasoning") {
        let summary = (item.summary ?? []).join("\n");
        if (len(summary) > 0) chat.thinking(summary);
    }
    else if (item.type == "commandExecution") {
        if (item.status == "declined") chat.tool_done(item.id, false, "Declined, Hex's tools do this (hex_search, hex_read, hex_files)");
        else chat.tool_done(item.id, item.status == "completed" && (item.exitCode ?? 0) == 0, item.aggregatedOutput ?? "");
    }
    else if (item.type == "mcpToolCall") chat.tool_done(item.id, item.status != "failed", item.result?.content ?? item.error ?? "");
    else if (item.type == "webSearch") chat.tool_done(item.id, true, item.query ?? "");
    else if (item.type == "fileChange") chat.tool_done(item.id, item.status != "failed" && item.status != "declined", changes_of(item));
    else if (item.type == "contextCompaction") chat.compacted({ trigger: "auto" });
    else if (item.type == "plan") chat.note(item.text ?? "");
}


// What a file change changed, a line a file with how
func changes_of(item) {
    return (item.changes ?? []).map(change => change.kind + " " + change.path).join("\n");
}

// The hex server added to ~/.codex/config.toml, after asking since it's the user's file and not the folder's
func connect(hex) {
    let config = hex.home + "/.codex/config.toml";
    let text = hex.exists(config) ? hex.read(config) : "";
    if (text.contains("[mcp_servers.hex]")) {
        hex.notify("Codex has a hex server already, in " + config);
        return;
    }
    hex.ask({ title: "Connect Codex", text: "Add the hex server to " + config + "? Hex has to be open with its MCP server on for Codex to reach it.", buttons: ["Add it", "Cancel"] }, (hex, pressed) => {
        if (pressed != "Add it") return;
        let section = "[mcp_servers.hex]\ncommand = '" + hex.executable + "'\nargs = [\"--mcp-connect\"]\n";
        hex.write(config, len(text) == 0 ? section : text.trim_end() + "\n\n" + section);
        hex.notify("Codex reaches Hex as the hex server from its next chat");
    });
}

// The block about the tools in the folder's AGENTS.md, put in place of the one there or added at the end
func teach(hex) {
    let folders = hex.workspace();
    if (len(folders) == 0) {
        hex.say("open a folder first");
        return;
    }
    let file = folders[0] + "/AGENTS.md";
    let text = hex.exists(file) ? hex.read(file) : "";
    let block = teach_start + "\n" + teaching + teach_end;
    let from = text.index_of(teach_start);
    let to = text.index_of(teach_end);
    if (from >= 0 && to > from) text = text.substring(0, from) + block + text.substring(to + len(teach_end));
    else if (len(text) == 0) text = block + "\n";
    else text = text.trim_end() + "\n\n" + block + "\n";
    hex.write(file, text);
    hex.notify("AGENTS.md says how to use Hex's tools now");
}
