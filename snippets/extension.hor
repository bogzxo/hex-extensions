// Snippets, a word typed and Tab, and it's written out as the code it stands for. fn then Tab in a JavaScript file is a
// function with its name selected, Tab again goes to its arguments, then into its body. The ones it comes with are in
// snippets.hor, your own go in a file of the same shape next to Hex (the command Edit my snippets makes it), and Insert
// snippet lists every one there is for the file on screen.
//
// A place Tab goes is followed as it's typed into on its own line. Typing a new line in it, or going off somewhere
// else, ends the run of places and Tab is a Tab again.
let extension = {
    name: "Snippets",
    description: "A word and Tab written out as the code it stands for, then Tab from one place in it to the next.",
    version: "1.0.0",
    author: "bogz",
    settings: {
        file: { title: "Your snippets", about: "A file of your own snippets, the same shape as the extension's snippets.hor. Empty for my_snippets.hor next to Hex.", kind: "path", default: "" },
        indent: { title: "Indent", about: "How many spaces a tab in a snippet is, 0 for a tab.", kind: "number", default: 4 }
    }
};

// What snippets.hor declares, an include hands it back rather than declaring it here
let builtin_snippets = include("snippets.hor").builtin_snippets;

// @doc The places Tab goes next in the snippet that was written out last, null when there's no run of them going
let session = null;

func on_start(hex) {
    hex.command("Insert snippet...", func(hex) { pick(hex); });
    hex.command("Edit my snippets", func(hex) {
        let path = own_file(hex);
        if (!hex.exists(path)) {
            hex.write(path, "// Your own snippets, the same shape as the ones Snippets comes with (its snippets.hor), and over them.\nlet snippets = {\n    \"*\": {\n    }\n};\n");
        }
        hex.open(path);
    });
}

// Tab, the next place of a snippet that's going, or a snippet written out of the word before the caret
func on_tab(hex, file) {
    if (hex.selection == null || hex.lines == null) {
        return false;
    }
    if (session != null && session.file == file && next_place(hex)) {
        return true;
    }
    session = null;
    return expand_at_caret(hex, file);
}

/* What the snippets are */

func ending_of(file) {
    if (file == null) { return ""; }
    let dot = -1;
    for (i in range(len(file))) {
        if (file[i] == ".") { dot = i; }
        if (file[i] == "/" || file[i] == "\\") { dot = -1; }
    }
    return dot < 0 ? "" : file.substring(dot).lower();
}

func own_file(hex) {
    let told = hex.setting("file");
    return told != null && told != "" ? told : "../../my_snippets.hor";
}

// @doc Every snippet there is for a file, its own over the ones that came with Snippets, by trigger
func snippets_for(hex, file) {
    let ending = ending_of(file);
    let found = {};
    let own = hex.try_load(own_file(hex));
    for (table in [builtin_snippets, own?.values?.snippets ?? {}]) {
        for (endings in table) {
            let all = endings.split(" ");
            if (all.contains("*") || all.contains(ending)) {
                for (trigger in table[endings]) {
                    let said = table[endings][trigger];
                    found[trigger] = typeof(said) == "text" ? { body: said, about: "" } : said;
                }
            }
        }
    }
    return found;
}

/* Writing one out */

func is_word(c) { return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"; }
func is_digit(c) { return c >= "0" && c <= "9"; }

// @doc A snippet's body as the text it's written out as, and its places in the order Tab goes to them, $0 last
func parse_body(body, unit) {
    let text = "";
    let places = [];
    let seen = {};
    let i = 0;
    let c = "";
    let digits = "";
    let key = "";
    let placeholder = "";
    while (i < len(body)) {
        c = body[i];
        if (c == "\t") {
            text += unit;
            i += 1;
            continue;
        }
        if (c == "\\" && i + 1 < len(body) && body[i + 1] == "$") {
            text += "$";
            i += 2;
            continue;
        }
        if (c != "$" || i + 1 >= len(body)) {
            text += c;
            i += 1;
            continue;
        }

        digits = "";
        placeholder = "";
        if (body[i + 1] == "{") {
            i += 2;
            while (i < len(body) && is_digit(body[i])) { digits += body[i]; i += 1; }
            if (i < len(body) && body[i] == ":") {
                i += 1;
                while (i < len(body) && body[i] != "}") { placeholder += body[i]; i += 1; }
            }
            i += 1;
        } else if (is_digit(body[i + 1])) {
            i += 1;
            while (i < len(body) && is_digit(body[i])) { digits += body[i]; i += 1; }
        } else {
            text += c;
            i += 1;
            continue;
        }

        // The same place twice (${1:i} in a for) is written out both times, Tab goes to the first of them
        key = "n" + digits;
        if (seen[key] == null) {
            seen[key] = true;
            places.push({ index: digits == "0" ? 1000000 : number(digits), offset: len(text), length: len(placeholder) });
        }
        text += placeholder;
    }
    places.sort(func(place) { return place.index; });
    return { text: text, places: places };
}

// Where a place of what's written out is in the file, the text put in at a line and column with a margin under its first line
func place_of(text, offset, line, column, margin) {
    let before = text.substring(0, offset);
    let breaks = 0;
    let last = -1;
    for (i in range(len(before))) {
        if (before[i] == "\n") {
            breaks += 1;
            last = i;
        }
    }
    return breaks == 0 ? { line: line, column: column + offset } : { line: line + breaks, column: len(margin) + offset - last };
}

func unit_of(hex) {
    let size = hex.setting("indent");
    return size != null && size > 0 ? " ".repeat(size) : "\t";
}

// A snippet written over a stretch of a line, the first place selected and the rest kept for Tab
func write_out(hex, file, snippet, line, from_column, to_column) {
    let text = hex.lines(line, line)[0];
    let indent = 0;
    while (indent < len(text) && (text[indent] == " " || text[indent] == "\t")) {
        indent += 1;
    }
    let margin = text.substring(0, indent);

    let made = parse_body(snippet.body, unit_of(hex));
    let written = made.text.replace("\n", "\n" + margin);
    hex.replace_text({ line: line, column: from_column }, { line: line, column: to_column }, written, len(written));

    let places = made.places.map(func(place) {
        let at = place_of(made.text, place.offset, line, from_column, margin);
        return { line: at.line, column: at.column, length: place.length };
    });
    if (len(places) == 0) {
        return;
    }
    show(hex, places[0]);
    session = len(places) > 1 ? { file: file, places: places, at: 0 } : null;
}

func show(hex, place) {
    hex.select({ line: place.line, column: place.column }, { line: place.line, column: place.column + place.length });
}

// The word before the caret written out if it's a snippet of the file, true when it was
func expand_at_caret(hex, file) {
    let s = hex.selection();
    if (s == null || s.text != "") {
        return false;
    }
    let line = hex.lines(s.caret.line, s.caret.line)[0];
    let end = s.caret.column - 1;
    let start = end;
    while (start > 0 && is_word(line[start - 1])) {
        start -= 1;
    }
    if (start == end) {
        return false;
    }
    let snippet = snippets_for(hex, file)[line.substring(start, end)];
    if (snippet == null) {
        return false;
    }
    write_out(hex, file, snippet, s.caret.line, start + 1, end + 1);
    return true;
}

// The next place of the snippet going, moved along by what was typed into the one before it. False when the caret
// isn't on the line of the place it was in any more, which ends the run
func next_place(hex) {
    let s = hex.selection();
    let place = session.places[session.at];
    if (s == null || s.caret.line != place.line) {
        return false;
    }

    // What was typed in the place moves the places after it on the same line along by as much
    let moved = s.caret.column - (place.column + place.length);
    for (i in range(session.at + 1, len(session.places))) {
        if (session.places[i].line == place.line) {
            session.places[i].column += moved;
        }
    }

    session.at += 1;
    show(hex, session.places[session.at]);
    if (session.at >= len(session.places) - 1) {
        session = null;
    }
    return true;
}

// Every snippet of the file on screen in a menu, the one picked written out where the caret is
func pick(hex) {
    if (hex.selection == null || hex.lines == null) {
        hex.say("needs a newer Hex, one with hex.selection and hex.lines");
        return;
    }
    let file = hex.file();
    let found = snippets_for(hex, file);
    let items = [];
    for (trigger in found) {
        let snippet = found[trigger];
        items.push({ label: trigger + (snippet.about != "" && snippet.about != null ? "  " + snippet.about : ""), on_pressed: func(hex) {
            let s = hex.selection();
            write_out(hex, file, snippet, s.from.line, s.from.column, s.from.line == s.to.line ? s.to.column : s.from.column);
        } });
    }
    if (len(items) == 0) {
        hex.say("no snippets for this kind of file");
        return;
    }
    hex.menu(items);
}
