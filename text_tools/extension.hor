// Text tools, the Edit menu of Sublime that Hex hadn't got. Lines sorted, reversed, made unique, joined and lined up,
// the case of a word changed (UPPER, lower, Title, snake_case, camelCase, PascalCase, kebab-case), and what's selected
// wrapped in brackets, quotes or a tag. Every one is in the command palette under Text tools, one step to undo each.
//
// The line commands work on the lines of the selection (a selection ending at the start of a line leaves that line out,
// the way Sublime has it), or the whole file when nothing is selected. The case commands work on what's selected, or on
// the word the caret is in.
let extension = {
    name: "Text tools",
    description: "Sort, reverse, unique and join lines, line them up, change the case of a word and wrap a selection.",
    version: "1.0.0",
    author: "bogz"
};

func on_start(hex) {
    hex.command("Sort lines", hex => { lines_through(hex, lines => lines.copy().sort(), true); }, "Ctrl+F9");
    hex.command("Sort lines, ignoring case", hex => { lines_through(hex, lines => lines.copy().sort(line => line.lower()), true); });
    hex.command("Reverse lines", hex => { lines_through(hex, lines => lines.copy().reverse(), true); });
    hex.command("Unique lines", hex => { lines_through(hex, lines => lines.unique(), true); });
    hex.command("Remove blank lines", hex => { lines_through(hex, lines => lines.filter(line => line.trim() != ""), true); });
    hex.command("Join lines", hex => { lines_through(hex, joined, false); }, "Ctrl+Shift+J");
    hex.command("Align lines on...", hex => {
        hex.prompt({ title: "Align lines", text: "What to line the selected lines up on.", value: "=", button: "Align" }, (hex, typed) => {
            if (typed != "") lines_through(hex, lines => aligned(lines, typed), true);
        });
    });

    hex.command("UPPER CASE", hex => { case_through(hex, s => s.upper()); });
    hex.command("lower case", hex => { case_through(hex, s => s.lower()); });
    hex.command("Title Case", hex => { case_through(hex, title_case); });
    hex.command("snake_case", hex => { case_through(hex, s => words(s).map(w => w.lower()).join("_")); });
    hex.command("kebab-case", hex => { case_through(hex, s => words(s).map(w => w.lower()).join("-")); });
    hex.command("camelCase", hex => { case_through(hex, s => camel(words(s), false)); });
    hex.command("PascalCase", hex => { case_through(hex, s => camel(words(s), true)); });

    hex.command("Wrap selection with...", hex => {
        hex.prompt({ title: "Wrap with", text: "A bracket, a quote, or a tag like <div class=\"x\">.", value: "(", button: "Wrap" }, (hex, typed) => {
            if (typed != "") wrap(hex, typed);
        });
    });
}

/* Where the commands work */

// @doc Whether this Hex has what these need, the selection and the lines of the file (Hex 1.0.3 and on)
func ready(hex) {
    if (hex.selection == null || hex.lines == null) {
        hex.say("needs a newer Hex, one with hex.selection and hex.lines");
        return false;
    }
    return hex.selection() != null;
}

// The lines of the selection, first and last from 1, or every line of the file when nothing is selected
func line_range(hex) {
    let s = hex.selection();
    if (s.from.line == s.to.line && s.from.column == s.to.column) return { first: 1, last: len(hex.lines()), whole: true };
    let last = s.to.line;
    if (s.to.column == 1 && last > s.from.line) last -= 1;
    return { first: s.from.line, last: last, whole: false };
}

// The lines of the selection put through a function and written back, selected again afterwards when they were
func lines_through(hex, change, keep_count) {
    if (!ready(hex)) return;
    let range = line_range(hex);
    let lines = hex.lines(range.first, range.last);
    if (!keep_count && range.whole) {
        // Join with nothing selected is the line the caret is on and the one under it
        let caret = hex.selection().caret.line;
        range = { first: caret, last: caret + 1, whole: false };
        lines = hex.lines(caret, caret + 1);
        if (len(lines) < 2) return;
    }

    let changed = change(lines);
    let text = changed.join("\n");
    if (text == lines.join("\n")) {
        hex.say("nothing to change");
        return;
    }
    hex.replace_text({ line: range.first, column: 1 }, { line: range.last, column: len(lines[-1]) + 1 }, text, len(text));
    if (!range.whole && len(changed) > 0)
        hex.select({ line: range.first, column: 1 }, { line: range.first + len(changed) - 1, column: len(changed[-1]) + 1 });
}

// The lines joined into one, the indentation of every line after the first taken off and one space between
func joined(lines) {
    let out = lines[0].trim_end();
    for (i in range(1, len(lines))) {
        let next = lines[i].trim();
        if (next != "") out = out.trim_end() + (out == "" ? "" : " ") + next;
    }
    return [out];
}

// Every line that has what they're lined up on padded so it's in the same column, one space either side of it
func aligned(lines, on) {
    let widest = 0;
    for (line in lines) {
        let at = line.index_of(on);
        if (at >= 0) widest = math.max(widest, len(line.substring(0, at).trim_end()));
    }
    return lines.map(line => {
        let at = line.index_of(on);
        if (at < 0) return line;
        let before = line.substring(0, at).trim_end();
        let after = line.substring(at + len(on)).trim();
        return before.pad_right(widest, " ") + " " + on + (after == "" ? "" : " " + after);
    });
}

/* Case */

// What's selected put through a function, or the word the caret is in when nothing is
func case_through(hex, change) {
    if (!ready(hex)) return;
    let { from, to, text, caret } = hex.selection();
    if (text == "") {
        let line = hex.lines(caret.line, caret.line)[0];
        let start = caret.column - 1;
        let end = start;
        while (start > 0 && line[start - 1].is_word()) start -= 1;
        while (end < len(line) && line[end].is_word()) end += 1;
        if (start == end) {
            hex.say("no word at the caret");
            return;
        }
        from = { line: caret.line, column: start + 1 };
        to = { line: caret.line, column: end + 1 };
        text = line.substring(start, end);
    }

    let changed = change(text);
    if (changed == text) return;
    hex.replace_text(from, to, changed, len(changed));
    if (!changed.contains("\n")) hex.select(from, { line: from.line, column: from.column + len(changed) });
}

// @doc The words of a name or a sentence, split at anything that isn't a letter or a digit and where camelCase turns
func words(s) {
    let out = [];
    let word = "";
    let before = "";
    let after = "";
    for (i, c in s) {
        if (!(c.is_letter() || c.is_digit())) {
            if (word != "") out.push(word);
            word = "";
            continue;
        }
        before = i > 0 ? s[i - 1] : "";
        after = i + 1 < len(s) ? s[i + 1] : "";
        // fooBar splits at the B, HTTPServer at the S, and a run of capitals stays one word
        if (word != "" && c.is_upper() && (before.is_lower() || before.is_digit() || (before.is_upper() && after.is_lower()))) {
            out.push(word);
            word = "";
        }
        word += c;
    }
    if (word != "") out.push(word);
    return out;
}

func capital(w) {
    return w == "" ? w : w.substring(0, 1).upper() + w.substring(1).lower();
}

func camel(parts, first_too) {
    let out = "";
    for (i, part in parts) out += (i == 0 && !first_too) ? part.lower() : capital(part);
    return out;
}

// Every word's first letter a capital and the rest small, the spaces and punctuation between them left as they are
func title_case(s) {
    let out = "";
    let start = true;
    for (c in s) {
        if (c.is_letter() || c.is_digit() || c == "'") {
            out += start ? c.upper() : c.lower();
            start = false;
        } else {
            out += c;
            start = true;
        }
    }
    return out;
}

/* Wrapping */

// @doc What closes what was typed to wrap with, the pairs the other way round and a tag's name with a slash
func closing_of(open) {
    let pairs = { "(": ")", "[": "]", "{": "}", "<": ">", "\"": "\"", "'": "'", "`": "`", "*": "*", "_": "_", "**": "**", "/*": "*/", "<!--": "-->" };
    if (pairs[open] != null) return pairs[open];
    if (open.starts_with("<") && open.ends_with(">") && len(open) > 2) {
        let name = "";
        let i = 1;
        while (i < len(open) && !(open[i] in [" ", ">", "/"])) {
            name += open[i];
            i += 1;
        }
        return `</{name}>`;
    }
    return open;
}

func wrap(hex, open) {
    if (!ready(hex)) return;
    let s = hex.selection();
    let close = closing_of(open);
    let text = open + s.text + close;
    hex.replace_text(s.from, s.to, text, len(open) + len(s.text));
    if (s.text == "") hex.say("wrapped nothing, the caret is between them");
}
