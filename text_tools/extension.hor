// Text tools, the Edit menu of Sublime that Hex hadn't got. Lines sorted, reversed, made unique, joined and lined up,
// the case of a word changed (UPPER, lower, Title, snake_case, camelCase, PascalCase, kebab-case), and what's selected
// wrapped in brackets, quotes or a tag. Every one is in the command palette under Text tools, one step to undo each.
//
// The line commands work on the lines of the selection (a selection ending at the start of a line leaves that line out,
// the way Sublime has it), or the whole file when nothing is selected. The case commands work on what's selected, or on
// the word the caret is in.
let extension = {
    name: "Text tools",
    description: "Sort, reverse, unique and join lines, line them up, change the case of a word and wrap a selection.",
    version: "1.0.0",
    author: "bogz"
};

func on_start(hex) {
    hex.command("Sort lines", func(hex) { lines_through(hex, func(lines) { return lines.copy().sort(); }, true); }, "Ctrl+F9");
    hex.command("Sort lines, ignoring case", func(hex) { lines_through(hex, func(lines) { return lines.copy().sort(func(line) { return line.lower(); }); }, true); });
    hex.command("Reverse lines", func(hex) { lines_through(hex, func(lines) { return lines.copy().reverse(); }, true); });
    hex.command("Unique lines", func(hex) { lines_through(hex, unique, true); });
    hex.command("Remove blank lines", func(hex) { lines_through(hex, func(lines) { return lines.filter(func(line) { return line.trim() != ""; }); }, true); });
    hex.command("Join lines", func(hex) { lines_through(hex, joined, false); }, "Ctrl+Shift+J");
    hex.command("Align lines on...", func(hex) {
        hex.prompt({ title: "Align lines", text: "What to line the selected lines up on.", value: "=", button: "Align" }, func(hex, typed) {
            if (typed != "") {
                lines_through(hex, func(lines) { return aligned(lines, typed); }, true);
            }
        });
    });

    hex.command("UPPER CASE", func(hex) { case_through(hex, func(s) { return s.upper(); }); });
    hex.command("lower case", func(hex) { case_through(hex, func(s) { return s.lower(); }); });
    hex.command("Title Case", func(hex) { case_through(hex, title_case); });
    hex.command("snake_case", func(hex) { case_through(hex, func(s) { return words(s).map(func(w) { return w.lower(); }).join("_"); }); });
    hex.command("kebab-case", func(hex) { case_through(hex, func(s) { return words(s).map(func(w) { return w.lower(); }).join("-"); }); });
    hex.command("camelCase", func(hex) { case_through(hex, func(s) { return camel(words(s), false); }); });
    hex.command("PascalCase", func(hex) { case_through(hex, func(s) { return camel(words(s), true); }); });

    hex.command("Wrap selection with...", func(hex) {
        hex.prompt({ title: "Wrap with", text: "A bracket, a quote, or a tag like <div class=\"x\">.", value: "(", button: "Wrap" }, func(hex, typed) {
            if (typed != "") {
                wrap(hex, typed);
            }
        });
    });
}

/* Where the commands work */

// @doc Whether this Hex has what these need, the selection and the lines of the file (Hex 1.0.3 and on)
func ready(hex) {
    if (hex.selection == null || hex.lines == null) {
        hex.say("needs a newer Hex, one with hex.selection and hex.lines");
        return false;
    }
    return hex.selection() != null;
}

// The lines of the selection, first and last from 1, or every line of the file when nothing is selected
func line_range(hex) {
    let s = hex.selection();
    if (s.from.line == s.to.line && s.from.column == s.to.column) {
        return { first: 1, last: len(hex.lines()), whole: true };
    }
    let last = s.to.line;
    if (s.to.column == 1 && last > s.from.line) {
        last -= 1;
    }
    return { first: s.from.line, last: last, whole: false };
}

// The lines of the selection put through a function and written back, selected again afterwards when they were
func lines_through(hex, change, keep_count) {
    if (!ready(hex)) {
        return;
    }
    let range = line_range(hex);
    let lines = hex.lines(range.first, range.last);
    if (!keep_count && range.whole) {
        // Join with nothing selected is the line the caret is on and the one under it
        let caret = hex.selection().caret.line;
        range = { first: caret, last: caret + 1, whole: false };
        lines = hex.lines(caret, caret + 1);
        if (len(lines) < 2) {
            return;
        }
    }

    let changed = change(lines);
    let text = changed.join("\n");
    if (text == lines.join("\n")) {
        hex.say("nothing to change");
        return;
    }
    let last_line = lines[len(lines) - 1];
    hex.replace_text({ line: range.first, column: 1 }, { line: range.last, column: len(last_line) + 1 }, text, len(text));
    if (!range.whole && len(changed) > 0) {
        let end = changed[len(changed) - 1];
        hex.select({ line: range.first, column: 1 }, { line: range.first + len(changed) - 1, column: len(end) + 1 });
    }
}

func unique(lines) {
    let seen = {};
    let kept = [];
    for (line in lines) {
        // An object's keys are its texts, a key of nothing but a number is still one
        let key = "_" + line;
        if (seen[key] == null) {
            seen[key] = true;
            kept.push(line);
        }
    }
    return kept;
}

// The lines joined into one, the indentation of every line after the first taken off and one space between
func joined(lines) {
    let out = trim_end(lines[0]);
    for (i in range(1, len(lines))) {
        let next = lines[i].trim();
        if (next != "") {
            out = trim_end(out) + (out == "" ? "" : " ") + next;
        }
    }
    return [out];
}

func trim_end(s) {
    let at = len(s);
    while (at > 0 && (s[at - 1] == " " || s[at - 1] == "\t")) {
        at -= 1;
    }
    return s.substring(0, at);
}

// Every line that has what they're lined up on padded so it's in the same column, one space either side of it
func aligned(lines, on) {
    let widest = 0;
    for (line in lines) {
        let at = line.index_of(on);
        if (at >= 0) {
            widest = math.max(widest, len(trim_end(line.substring(0, at))));
        }
    }
    return lines.map(func(line) {
        let at = line.index_of(on);
        if (at < 0) {
            return line;
        }
        let before = trim_end(line.substring(0, at));
        let after = line.substring(at + len(on)).trim();
        return before.pad_right(widest, " ") + " " + on + (after == "" ? "" : " " + after);
    });
}

/* Case */

func is_letter(c) { return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z"); }
func is_digit(c) { return c >= "0" && c <= "9"; }
func is_word(c) { return is_letter(c) || is_digit(c) || c == "_"; }
func is_upper(c) { return c >= "A" && c <= "Z"; }
func is_lower(c) { return c >= "a" && c <= "z"; }

// What's selected put through a function, or the word the caret is in when nothing is
func case_through(hex, change) {
    if (!ready(hex)) {
        return;
    }
    let s = hex.selection();
    let from = s.from;
    let to = s.to;
    let text = s.text;
    if (text == "") {
        let line = hex.lines(s.caret.line, s.caret.line)[0];
        let start = s.caret.column - 1;
        let end = start;
        while (start > 0 && is_word(line[start - 1])) { start -= 1; }
        while (end < len(line) && is_word(line[end])) { end += 1; }
        if (start == end) {
            hex.say("no word at the caret");
            return;
        }
        from = { line: s.caret.line, column: start + 1 };
        to = { line: s.caret.line, column: end + 1 };
        text = line.substring(start, end);
    }

    let changed = change(text);
    if (changed == text) {
        return;
    }
    hex.replace_text(from, to, changed, len(changed));
    if (!changed.contains("\n")) {
        hex.select(from, { line: from.line, column: from.column + len(changed) });
    }
}

// @doc The words of a name or a sentence, split at anything that isn't a letter or a digit and where camelCase turns
func words(s) {
    let out = [];
    let word = "";
    let c = "";
    let before = "";
    let after = "";
    for (i in range(len(s))) {
        c = s[i];
        if (!(is_letter(c) || is_digit(c))) {
            if (word != "") { out.push(word); }
            word = "";
            continue;
        }
        before = i > 0 ? s[i - 1] : "";
        after = i + 1 < len(s) ? s[i + 1] : "";
        // fooBar splits at the B, HTTPServer at the S, and a run of capitals stays one word
        if (word != "" && is_upper(c) && (is_lower(before) || is_digit(before) || (is_upper(before) && is_lower(after)))) {
            out.push(word);
            word = "";
        }
        word += c;
    }
    if (word != "") { out.push(word); }
    return out;
}

func capital(w) {
    return w == "" ? w : w.substring(0, 1).upper() + w.substring(1).lower();
}

func camel(parts, first_too) {
    let out = "";
    for (i in range(len(parts))) {
        out += (i == 0 && !first_too) ? parts[i].lower() : capital(parts[i]);
    }
    return out;
}

// Every word's first letter a capital and the rest small, the spaces and punctuation between them left as they are
func title_case(s) {
    let out = "";
    let start = true;
    for (i in range(len(s))) {
        let c = s[i];
        if (is_letter(c) || is_digit(c) || c == "'") {
            out += start ? c.upper() : c.lower();
            start = false;
        } else {
            out += c;
            start = true;
        }
    }
    return out;
}

/* Wrapping */

// @doc What closes what was typed to wrap with, the pairs the other way round and a tag's name with a slash
func closing_of(open) {
    let pairs = { "(": ")", "[": "]", "{": "}", "<": ">", "\"": "\"", "'": "'", "`": "`", "*": "*", "_": "_", "**": "**", "/*": "*/", "<!--": "-->" };
    if (pairs[open] != null) {
        return pairs[open];
    }
    if (open.starts_with("<") && open.ends_with(">") && len(open) > 2) {
        let name = "";
        let i = 1;
        while (i < len(open) && open[i] != " " && open[i] != ">" && open[i] != "/") {
            name += open[i];
            i += 1;
        }
        return "</" + name + ">";
    }
    return open;
}

func wrap(hex, open) {
    if (!ready(hex)) {
        return;
    }
    let s = hex.selection();
    let close = closing_of(open);
    let text = open + s.text + close;
    hex.replace_text(s.from, s.to, text, len(open) + len(s.text));
    if (s.text == "") {
        hex.say("wrapped nothing, the caret is between them");
    }
}
